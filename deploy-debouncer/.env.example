# Env vars for the deploy-debouncer Vercel project (set these in that
# project's Vercel dashboard — NOT in tryllemuseet-web or tryllemuseet-prod).

SANITY_PROJECT_ID=n2ynpgty
SANITY_DATASET=production

# Sanity API token with write access (same one used by scripts/ in the main repo).
SANITY_TOKEN=

# The two deploy hook URLs this used to call directly from Sanity's webhook —
# move them here instead of leaving them in the Sanity webhook config.
VERCEL_DEPLOY_HOOK_WEB=
VERCEL_DEPLOY_HOOK_PROD=

# Minimum time between real deploys, in milliseconds. Default: 3 minutes.
# DEBOUNCE_COOLDOWN_MS=180000
