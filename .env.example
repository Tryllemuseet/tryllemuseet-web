# Environment variables for the Sanity Studio (root).
# Copy to .env (git-ignored) as needed. Studio works without it — falls back
# to the production dataset in sanity.config.ts / sanity.cli.ts.

# Point a local `npm run dev` / `npm run start` at a different dataset, e.g.
# a "development" dataset used for testing risky schema changes before they
# run against the real production content. Leave unset for normal editing.
# SANITY_STUDIO_DATASET=development
