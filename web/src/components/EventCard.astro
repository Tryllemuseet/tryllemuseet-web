---
// src/components/EventCard.astro
// Shared event card: keeps event info and any external booking action as
// two clearly separate, sibling controls (never nested) so the "meld på"
// action never gets confused with the informational title link.
export interface Props {
  date: string
  title: string
  excerpt?: string
  ageGroup?: string
  price?: string
  bookingUrl?: string
  href?: string
}

const { date, title, excerpt, ageGroup, price, bookingUrl, href = '/aktiviteter' } = Astro.props

// Arrangementene er i Oslo — vis alltid klokkeslett/dato i Oslo lokaltid,
// uavhengig av hvilken tidssone build-serveren kjører i (statisk generert).
const TZ = 'Europe/Oslo'
const d = new Date(date)
const day = d.toLocaleDateString('nb-NO', { day: 'numeric', timeZone: TZ })
const month = d.toLocaleDateString('nb-NO', { month: 'short', timeZone: TZ })
const time = d.toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit', timeZone: TZ })
---

<article class="event-card">
  <div class="event-date-block">
    <span class="event-day">{day}</span>
    <span class="event-month">{month}</span>
  </div>
  <div class="event-body">
    <div class="event-meta">
      {ageGroup && <span class="event-tag">{ageGroup}</span>}
      <span class="event-time">{time}</span>
      {price && <span class="event-price">{price}</span>}
    </div>
    <h3 class="event-title"><a href={href}>{title}</a></h3>
    {excerpt && <p class="event-excerpt">{excerpt}</p>}
  </div>
  {bookingUrl && (
    <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="event-book" aria-label={`Meld deg på ${title}`}>
      Meld på →
    </a>
  )}
</article>

<style>
  .event-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: white;
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    transition: box-shadow 200ms ease, border-color 200ms ease;
  }
  .event-card:hover { box-shadow: var(--shadow); border-color: var(--gold-light); }

  .event-date-block { display: flex; flex-direction: column; align-items: center; min-width: 56px; }
  .event-day { font-family: var(--font-display); font-size: 1.8rem; color: var(--burgundy); line-height: 1.1; }
  .event-month { font-family: var(--font-ui); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold-dark); font-weight: 700; }

  .event-body { flex: 1; min-width: 0; }
  .event-meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.3rem; }
  .event-tag { font-family: var(--font-ui); font-size: var(--text-xs); font-weight: 600; background: var(--cream-dark); color: var(--ink-mid); padding: 0.15rem 0.5rem; border-radius: 3px; }
  .event-time, .event-price { font-family: var(--font-ui); font-size: var(--text-xs); color: var(--grey); }
  .event-price { color: #2E7D32; font-weight: 600; }

  .event-title { font-family: var(--font-display); font-size: var(--text-lg); color: var(--burgundy); letter-spacing: 0.02em; line-height: 1.3; margin-bottom: 0.3rem; }
  .event-title a { color: inherit; }
  .event-title a:hover { color: var(--gold-dark); }
  .event-excerpt { font-family: var(--font-ui); font-size: var(--text-sm); color: var(--ink-mid); line-height: 1.55; }

  .event-book {
    flex-shrink: 0;
    align-self: center;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    background: var(--gold);
    color: var(--burgundy-dk);
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-sm);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition: background 180ms;
  }
  .event-book:hover { background: var(--gold-light); }

  @media (max-width: 520px) {
    .event-card { flex-direction: column; }
    .event-date-block { flex-direction: row; gap: 0.4rem; }
    .event-book { align-self: stretch; justify-content: center; }
  }
</style>
