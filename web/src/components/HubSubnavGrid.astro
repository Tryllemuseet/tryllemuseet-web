---
// src/components/HubSubnavGrid.astro
//
// Sikkerhetsnett-kort for underområder som ikke (ennå) har et eget
// håndkurert kort på hub-siden — hentet fra getUncoveredSubAreas() i
// lib/sanity.ts, som bruker siteNavigation (samme sannhetskilde som selve
// menyen) og trekker fra lenkene siden allerede dekker eksplisitt. Se
// tryllemuseet_sanity_hubs_automatisk_levende_innhold.md § 5–6: dropdown-
// menyen skal være en snarvei, ikke eneste vei inn i et underområde.
// Kortene her er bevisst enkle (kun tittel/lenke) — ingen ikon/beskrivelse
// er ment; det får håndkurerte kort i stedet.
import ContentCard from './ContentCard.astro'

export interface Props {
  heading: string
  items:   { label: string; link: string }[]
}

const { heading, items } = Astro.props
---

{items.length > 0 && (
  <section class="hub-subnav-grid" aria-labelledby="hub-subnav-heading">
    <h2 class="hub-subnav-heading" id="hub-subnav-heading">{heading}</h2>
    <div class="hub-subnav-cards">
      {items.map(item => (
        <ContentCard variant="compact" title={item.label} href={item.link} ctaText="Utforsk →" />
      ))}
    </div>
  </section>
)}

<style>
  .hub-subnav-grid { margin-top: 2.5rem; }
  .hub-subnav-heading {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--grey);
    margin-bottom: 1rem;
  }
  .hub-subnav-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
</style>
