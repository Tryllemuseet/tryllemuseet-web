---
// Tab bar for the history overview pages (Konkurransehistorie,
// Foreningshistorie). The panels are the page's own markup, passed in the
// default slot: one <section data-tab-panel id="<tab id>"> per tab, each
// starting with an <h2 class="panel-title">.
//
// Progressive enhancement: without JavaScript the tab bar stays hidden and
// every panel shows, one after the other. With it, one panel shows at a time,
// plus a «Vis alle» tab that shows them all again (handy for Ctrl+F).
// Each tab has its own URL hash (#nm), and a hash pointing at something inside
// a panel (#norgesmestere) opens that panel and scrolls to it, so links from
// other pages land in the right tab. Back/forward move between tabs.
interface Props {
  tabs: readonly { id: string; label: string }[]
  label: string
}
const { tabs, label } = Astro.props
const allTabs = [...tabs, { id: 'alle', label: 'Vis alle' }]
---

<div class="history-tabs" data-history-tabs>
  <div class="tablist-wrap">
    <div class="tablist" role="tablist" aria-label={label} hidden>
      {allTabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`fane-${t.id}`}
          data-tab={t.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={t.id === 'alle' ? tabs.map(x => x.id).join(' ') : t.id}
          tabindex={i === 0 ? 0 : -1}
          class={t.id === 'alle' ? 'tab tab--alle' : 'tab'}
        >{t.label}</button>
      ))}
    </div>
  </div>
  <div class="panels">
    <slot />
  </div>
</div>

<script>
  function setup(root: HTMLElement) {
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]')!
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const panels = [...root.querySelectorAll<HTMLElement>('[data-tab-panel]')]
    if (!tabs.length || !panels.length) return
    const ids = tabs.map(t => t.dataset.tab!)

    for (const p of panels) {
      p.setAttribute('role', 'tabpanel')
      p.setAttribute('aria-labelledby', `fane-${p.id}`)
      p.tabIndex = 0
    }
    tablist.hidden = false

    function activate(id: string) {
      if (!ids.includes(id)) id = ids[0]
      root.dataset.mode = id === 'alle' ? 'alle' : 'en'
      for (const t of tabs) {
        const on = t.dataset.tab === id
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
      }
      for (const p of panels) p.hidden = id !== 'alle' && p.id !== id
    }

    // Tab id, or the id of something inside a panel (a section anchor).
    function fromHash(scroll: boolean) {
      const hash = decodeURIComponent(location.hash.slice(1))
      if (!hash) return activate(ids[0])
      if (ids.includes(hash)) return activate(hash)
      const target = document.getElementById(hash)
      const panel = target?.closest<HTMLElement>('[data-tab-panel]')
      if (panel && target) {
        activate(panel.id)
        if (scroll) requestAnimationFrame(() => target.scrollIntoView())
      } else {
        activate(ids[0])
      }
    }

    function select(id: string, focus = false) {
      activate(id)
      history.pushState(null, '', `#${id}`)
      if (focus) tabs.find(t => t.dataset.tab === id)?.focus()
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!))
      t.addEventListener('keydown', e => {
        const next =
          e.key === 'ArrowRight' ? (i + 1) % tabs.length :
          e.key === 'ArrowLeft'  ? (i - 1 + tabs.length) % tabs.length :
          e.key === 'Home'       ? 0 :
          e.key === 'End'        ? tabs.length - 1 : -1
        if (next < 0) return
        e.preventDefault()
        select(tabs[next].dataset.tab!, true)
      })
    })
    window.addEventListener('popstate', () => fromHash(false))
    window.addEventListener('hashchange', () => fromHash(true))
    fromHash(true)
  }

  document.querySelectorAll<HTMLElement>('[data-history-tabs]').forEach(setup)
</script>

<style>
  .tablist-wrap {
    position: sticky; top: var(--header-height, 72px); z-index: 5;
    background: var(--cream); margin: 0 -1rem 2rem; padding: 0.75rem 1rem 0;
    border-bottom: 1px solid rgba(107,15,26,0.15);
  }
  .tablist {
    display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .tab {
    flex: 0 0 auto; appearance: none; border: 0; background: none; cursor: pointer;
    font-family: var(--font-ui); font-size: 0.88rem; color: #6b5a50;
    padding: 0.6rem 0.9rem 0.7rem; border-bottom: 3px solid transparent; white-space: nowrap;
  }
  .tab:hover { color: var(--burgundy); }
  .tab[aria-selected='true'] { color: var(--burgundy); font-weight: 600; border-bottom-color: var(--gold); }
  .tab:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; }
  .tab--alle { margin-left: auto; color: #8a7a70; }

  /* Panel headings repeat the tab label: only useful when several panels show. */
  .history-tabs[data-mode='en'] :global(.panel-title) {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .history-tabs :global(.panel-title) {
    font-family: var(--font-display); font-size: 1.6rem; color: var(--burgundy);
    margin: 0 0 1.5rem; padding-top: 0.5rem;
  }
  .history-tabs[data-mode='alle'] :global([data-tab-panel]) + :global([data-tab-panel]) {
    border-top: 1px solid rgba(107,15,26,0.15); padding-top: 2rem; margin-top: 1rem;
  }
  :global([data-tab-panel]):focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
</style>
