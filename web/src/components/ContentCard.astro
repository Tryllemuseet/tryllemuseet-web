---
// src/components/ContentCard.astro
// Shared card for the "image/icon + kicker + title + description + link"
// shape that used to be redefined per page (whoknew-card, fremhevet-card,
// monthly-card, tema-mini-card, aktuell-card, section-card, th-card, …).
export interface Props {
  variant?: 'standard' | 'featured' | 'dark' | 'compact'
  imageUrl?: string
  imageAlt?: string
  icon?: string
  label?: string
  title: string
  description?: string
  href?: string
  ctaText?: string
  status?: string
}

const {
  variant = 'standard',
  imageUrl,
  imageAlt,
  icon,
  label,
  title,
  description,
  href,
  ctaText,
  status,
} = Astro.props

const Tag = href ? 'a' : 'div'
const hasMedia = !!(imageUrl || icon)
---

<Tag
  href={href}
  class:list={[
    'content-card',
    `content-card--${variant}`,
    { 'content-card--soon': !href && !!status },
  ]}
  aria-disabled={!href ? 'true' : undefined}
>
  {hasMedia && variant !== 'compact' && (
    <div class="content-card-media">
      {imageUrl
        ? <img src={imageUrl} alt={imageAlt ?? ''} loading="lazy" />
        : <span class="content-card-icon" aria-hidden="true">{icon}</span>
      }
    </div>
  )}
  <div class="content-card-body">
    {variant === 'compact' && icon && <span class="content-card-icon content-card-icon--inline" aria-hidden="true">{icon}</span>}
    <div class="content-card-text">
      {label && <span class="content-card-label">{label}</span>}
      <h3 class="content-card-title">{title}</h3>
      {description && <p class="content-card-desc">{description}</p>}
      {status
        ? <span class="content-card-status">{status}</span>
        : ctaText && <span class="content-card-cta">{ctaText}</span>
      }
    </div>
  </div>
</Tag>

<style>
  .content-card {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    height: 100%;
  }
  a.content-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--gold-light); }
  .content-card--soon { opacity: 0.65; cursor: default; }

  .content-card-media { aspect-ratio: 7/5; overflow: hidden; background: var(--cream-dark); display: flex; align-items: center; justify-content: center; }
  .content-card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 320ms ease; }
  a.content-card:hover .content-card-media img { transform: scale(1.04); }
  .content-card-icon { font-size: 2.75rem; line-height: 1; }

  .content-card-body { padding: 1.25rem 1.5rem 1.5rem; display: flex; flex: 1; }
  .content-card-text { display: flex; flex-direction: column; flex: 1; }

  .content-card-label { font-family: var(--font-ui); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-dark); margin-bottom: 0.3rem; }
  .content-card-title { font-family: var(--font-display); font-size: var(--text-lg); color: var(--burgundy); margin-bottom: 0.4rem; letter-spacing: 0.02em; line-height: 1.3; }
  .content-card-desc { font-family: var(--font-ui); font-size: var(--text-sm); color: var(--ink-mid); line-height: 1.55; flex: 1; }
  .content-card-cta { font-family: var(--font-ui); font-size: var(--text-sm); font-weight: 600; color: var(--burgundy); margin-top: 1rem; transition: color 180ms ease; }
  a.content-card:hover .content-card-cta { color: var(--gold-dark); }
  .content-card-status { display: inline-block; margin-top: 1rem; font-family: var(--font-ui); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--grey); border: 1px solid var(--grey-light); padding: 0.2rem 0.65rem; border-radius: 2rem; align-self: flex-start; }

  /* ── compact: icon + text side by side, no media block ── */
  .content-card--compact { flex-direction: row; }
  .content-card--compact .content-card-body { align-items: flex-start; gap: 1.1rem; padding: 1.5rem; }
  .content-card-icon--inline { margin-top: 0.1rem; flex-shrink: 0; }

  /* ── featured / dark: horizontal split, burgundy background ── */
  .content-card--featured,
  .content-card--dark {
    flex-direction: row;
    background: var(--burgundy-dk);
    border-color: var(--gold-dark);
    color: var(--cream);
  }
  .content-card--featured .content-card-media,
  .content-card--dark .content-card-media { flex: 0 0 42%; aspect-ratio: auto; background: rgba(255,255,255,0.05); }
  .content-card--featured .content-card-body,
  .content-card--dark .content-card-body { flex: 1; padding: 1.75rem 2rem; }
  .content-card--featured .content-card-title,
  .content-card--dark .content-card-title { color: var(--cream); font-size: var(--text-xl); }
  .content-card--featured .content-card-desc,
  .content-card--dark .content-card-desc { color: rgba(244,238,225,0.85); }
  .content-card--featured .content-card-cta,
  .content-card--dark .content-card-cta { color: var(--gold-light); }
  a.content-card--featured:hover .content-card-cta,
  a.content-card--dark:hover .content-card-cta { color: var(--gold); }

  @media (max-width: 640px) {
    .content-card--featured,
    .content-card--dark,
    .content-card--compact { flex-direction: column; }
    .content-card--featured .content-card-media,
    .content-card--dark .content-card-media { flex: none; aspect-ratio: 4/3; }
  }
</style>
