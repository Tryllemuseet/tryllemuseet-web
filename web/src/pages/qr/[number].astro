---
// src/pages/qr/[number].astro
//
// Stabil URL trykt på fysiske QR-koder i museet: /qr/{qrNumber}. Slår opp
// gjeldende /utstillingen/{slug} for nummeret på byggetidspunkt, slik at et
// klistremerke ikke trenger byttes ut selv om artikkelen får ny slug.
// Se getQrRedirects() i lib/sanity.ts og QR-kodenummer-feltet i schemaTypes/legend.ts.
import { getQrRedirects } from '../../lib/sanity'

export async function getStaticPaths() {
  const entries = await getQrRedirects()
  return entries
    .filter(e => e.slug)
    .map(e => ({
      params: { number: String(e.qrNumber) },
      props: { slug: e.slug },
    }))
}

const { slug } = Astro.props
return Astro.redirect(`/utstillingen/${slug}`, 301)
---
