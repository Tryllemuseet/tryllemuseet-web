  }
  .tg-chip.is-on { background: var(--tg-glow); border-color: var(--tg-glow); color: var(--ink); }

  /* Start: who are you? */
  .tg-pick { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); }
  .tg-pick-btn {
    display: flex; flex-direction: column; align-items: center; gap: .25rem; padding: var(--space-4) var(--space-2);
    background: #fff; border: 3px solid transparent; border-radius: 16px; cursor: pointer;
    font: 400 1rem var(--font-ui); color: var(--ink); box-shadow: var(--shadow);
  }
  .tg-pick-btn strong { font-size: 1.15rem; color: var(--tg-accent); }
  .tg-pick-btn:hover, .tg-pick-btn.is-on { border-color: var(--tg-glow); }
  .tg-pick-icon { font-size: 2.6rem; line-height: 1; }

  /* Speech bubbles */
  .tg-talk { display: flex; flex-direction: column; gap: var(--space-3); }
  .tg-bubble { display: flex; align-items: center; gap: var(--space-3); background: #fff; border-radius: 18px; padding: var(--space-3); box-shadow: var(--shadow-sm); animation: tg-pop .3s ease-out; }
  .tg-bubble--gutt { flex-direction: row-reverse; }
