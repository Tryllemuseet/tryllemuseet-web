    background: linear-gradient(180deg, var(--tg-sky) 0%, color-mix(in srgb, var(--tg-sky) 70%, #5b79b8) 100%);
    padding: var(--space-5) var(--space-4) var(--space-7);
    font-family: var(--font-ui);
    color: var(--ink);
    flex: 1;
    /* The site header is sticky: keep the game's top bar clear of it. */
