  @keyframes tg-drop { from { transform: translate(-50%, -260%) scale(1.6); opacity: 0; } to { transform: translate(-50%, -50%); opacity: 1; } }

  @media (max-width: 560px) {
    .tg { padding-inline: var(--space-2); }
    .tg-pick { grid-template-columns: 1fr; }
    .tg-pick-btn { flex-direction: row; justify-content: flex-start; gap: var(--space-3); padding: var(--space-3) var(--space-4); }
    .tg-chip span { display: none; }
    .tg-chip.is-on span { display: inline; }
    .tg-avatar { width: 52px; height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tg *, .tg-toast { animation: none !important; transition: none !important; }
    .tg-bird.is-on { transform: translate(-50%, -50%); box-shadow: 0 0 0 4px #fff; }
  }
</style>
