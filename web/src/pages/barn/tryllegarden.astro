  .tg-kicker { font-size: .85rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--tg-accent2); }
  .tg-title { font-family: var(--font-display); font-size: clamp(1.8rem, 6vw, 2.8rem); line-height: 1.15; color: var(--tg-accent); margin-top: var(--space-2); }
  .tg-subtitle { font-family: var(--font-display); font-size: clamp(1.1rem, 3.5vw, 1.5rem); color: var(--tg-accent2); margin-top: var(--space-1); }
  .tg-h1 { font-family: var(--font-display); font-size: clamp(1.5rem, 5vw, 2.1rem); line-height: 1.2; color: var(--tg-accent); }
  .tg-h2 { font-size: 1.2rem; font-weight: 700; color: var(--tg-accent2); }
  .tg-lead { font-size: 1.2rem; line-height: 1.55; }
  .tg-lead--tight { margin-top: var(--space-2); }
  .tg-task { font-size: 1.2rem; font-weight: 600; margin-top: var(--space-2); }
  .tg-note { font-size: 1rem; color: var(--ink-mid); }
  .tg-status { font-size: 1.15rem; font-weight: 700; text-align: center; }
  .tg-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }

  /* Buttons: big enough for small fingers. */
  .tg-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    min-height: 56px; padding: .75rem 1.6rem;
    font: 700 1.15rem var(--font-ui); color: #fff; text-decoration: none;
    background: var(--tg-accent); border: 0; border-radius: 999px; cursor: pointer;
    box-shadow: 0 4px 0 color-mix(in srgb, var(--tg-accent) 65%, #000);
  }
  .tg-btn:hover { filter: brightness(1.08); }
  .tg-btn:active { transform: translateY(2px); box-shadow: 0 2px 0 color-mix(in srgb, var(--tg-accent) 65%, #000); }
  .tg-btn:disabled { opacity: .55; cursor: default; }
  .tg-btn--ghost { background: #fff; color: var(--tg-accent2); box-shadow: inset 0 0 0 2px var(--tg-accent2); }
  .tg-btn--glow { background: var(--tg-glow); color: var(--ink); box-shadow: 0 4px 0 color-mix(in srgb, var(--tg-glow) 60%, #000), 0 0 24px color-mix(in srgb, var(--tg-glow) 70%, transparent); }
  .tg-say {
    flex-shrink: 0; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
    background: #fff; font-size: 1.3rem; box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--tg-accent2) 40%, transparent);
    display: none; vertical-align: middle;
  }
  .tg-can-speak .tg-say { display: inline-flex; align-items: center; justify-content: center; }
  .tg-speech-only { display: none !important; }
  .tg-can-speak .tg-speech-only { display: inline-flex !important; }
