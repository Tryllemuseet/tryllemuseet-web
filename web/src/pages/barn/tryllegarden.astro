  .tg-bubble-body { flex: 1; }
  .tg-avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; object-position: center top; flex-shrink: 0; border: 3px solid var(--tg-glow); background: #fff; }
  .tg-avatar--book { display: flex; align-items: center; justify-content: center; font-size: 1.8rem; background: #fff; border-color: transparent; }
  .tg-who { font-size: .85rem; font-weight: 700; color: var(--tg-accent2); }
  .tg-text { font-size: 1.2rem; line-height: 1.45; }

  /* Scenes */
  .tg-scene { position: relative; aspect-ratio: 16 / 10; border-radius: 16px; overflow: hidden; background: var(--tg-sky); }
  .tg-scene--short { aspect-ratio: 16 / 6; }
  .tg-scene--mid { aspect-ratio: 16 / 8; }
  .tg-scene--mid .tg-backdrop { object-position: center 60%; }
  .tg-backdrop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tg-thing, .tg-bird, .tg-hat, .tg-spot {
    position: absolute; transform: translate(-50%, -50%); background: none; border: 0; padding: 0; cursor: pointer; line-height: 1;
  }
  .tg-thing { width: 12%; aspect-ratio: 1; font-size: clamp(1.2rem, 5.2vw, 2.6rem); display: flex; align-items: center; justify-content: center; border-radius: 50%; }
  .tg-thing img { width: 100%; height: 100%; object-fit: contain; }
  .tg-lvl-smanisse .tg-thing { width: 16%; font-size: clamp(1.6rem, 7vw, 3.4rem); }
  .tg-lvl-mester .tg-thing { width: 9%; font-size: clamp(.95rem, 3.6vw, 1.8rem); opacity: .85; }
  .tg-thing.is-found { opacity: 1; background: color-mix(in srgb, var(--tg-glow) 75%, transparent); box-shadow: 0 0 0 3px #fff; cursor: default; }
  .is-hint { animation: tg-glow 1s ease-in-out infinite; border-radius: 16px; box-shadow: 0 0 0 4px var(--tg-glow); }
  .tg-hat { width: 14%; min-width: 56px; opacity: .92; transform: translate(-50%, -62%); }
  .tg-hat img, .tg-hat svg { width: 100%; height: auto; display: block; }
  .tg-hat--ghost { width: 12%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); opacity: 1; }
  .tg-hat--ghost.is-found { box-shadow: 0 0 0 4px var(--tg-glow), 0 0 18px var(--tg-glow); }
  .tg-hat.is-found { opacity: 1; filter: drop-shadow(0 0 6px var(--tg-glow)); }

  .tg-checklist { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); justify-content: center; padding: 0; margin-top: var(--space-3); }
  .tg-checklist li { display: inline-flex; align-items: center; gap: .4rem; background: #fff; border-radius: 999px; padding: .35rem .9rem; font-weight: 600; font-size: 1.05rem; }
  .tg-checklist li img, .tg-checklist li svg { width: 1.6rem; height: 1.6rem; }
  .tg-checklist li.is-found { background: var(--tg-accent2); color: #fff; }
  .tg-checklist li.is-found::after { content: '✓'; font-weight: 700; }

  /* Order game */
  .tg-slots { list-style: none; padding: 0; display: grid; gap: var(--space-2); margin-top: var(--space-3); }
  .tg-slot { display: flex; align-items: center; gap: var(--space-3); min-height: 56px; padding: .4rem .8rem; border: 2px dashed color-mix(in srgb, var(--tg-accent2) 50%, transparent); border-radius: 14px; font-size: 1.1rem; }
  .tg-slot.is-filled { border-style: solid; border-color: var(--tg-accent2); background: #fff; font-weight: 600; animation: tg-pop .3s ease-out; }
  .tg-slot-num { flex-shrink: 0; width: 2rem; height: 2rem; border-radius: 50%; background: var(--tg-accent2); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .tg-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: var(--space-2); margin-top: var(--space-4); }
  .tg-cardbtn { display: flex; align-items: center; gap: var(--space-3); min-height: 64px; padding: .6rem 1rem; text-align: left; background: #fff; border: 3px solid transparent; border-radius: 14px; cursor: pointer; font: 600 1.1rem var(--font-ui); color: var(--ink); box-shadow: var(--shadow); }
  .tg-cardbtn > span[aria-hidden], .tg-slot-body > span[aria-hidden] { font-size: 1.8rem; line-height: 1; }
  .tg-cardbtn img, .tg-slot-body img { width: 3.4rem; height: 3.4rem; object-fit: contain; flex-shrink: 0; }
  .tg-slot-body { display: inline-flex; align-items: center; gap: var(--space-3); }
  .tg-cardbtn:hover { border-color: var(--tg-glow); }
  .tg-cardbtn.is-out { opacity: .4; text-decoration: line-through; cursor: default; }
  .tg-cardbtn.is-hint { border-color: var(--tg-glow); }
  .tg-cardbtn.is-shake { animation: tg-shake .35s; }
  .tg-cardbtn[hidden] { display: none; }

  /* Memory game */
  .tg-bird { width: 17%; display: flex; flex-direction: column; align-items: center; border-radius: 14px; padding: 1%; transition: transform .2s; }
  .tg-bird svg, .tg-bird img { width: 100%; height: auto; display: block; }
  .tg-bird-name { font: 700 clamp(.6rem, 2.1vw, .95rem) var(--font-ui); color: #fff; background: rgba(0, 0, 0, .5); border-radius: 999px; padding: .1em .6em; margin-top: 2px; white-space: nowrap; }
  .tg-bird.is-on { transform: translate(-50%, -62%) scale(1.25); background: color-mix(in srgb, var(--tg-glow) 80%, transparent); }
  .tg-bird.is-ok { background: color-mix(in srgb, #7bd88f 80%, transparent); }

  /* Follow the braid */
  .tg-thread { max-width: 560px; margin: var(--space-3) auto 0; }
  .tg-thread-row { display: grid; grid-template-columns: repeat(var(--n), 1fr); justify-items: center; }
  .tg-bow { min-width: 56px; min-height: 56px; background: #fff; border: 3px solid transparent; border-radius: 14px; cursor: pointer; font-size: 1.6rem; line-height: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: var(--shadow); }
  .tg-bow b { font: 700 .9rem var(--font-ui); color: var(--tg-accent2); }
  .tg-bow:hover { border-color: var(--tg-glow); }
  .tg-thread-svg { display: block; width: 100%; height: clamp(170px, 42vw, 260px); }
  .tg-braid.is-lit path:last-child { stroke: var(--tg-accent); stroke-width: 3.4; }
  .tg-braid.is-hint { animation: none; box-shadow: none; }
