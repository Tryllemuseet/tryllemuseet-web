  .tg-end { font-size: 2rem; line-height: 1; padding: .2rem .5rem; border-radius: 12px; border: 3px solid transparent; }
  .tg-end img { width: 2.4rem; height: 2.4rem; object-fit: contain; }
  .tg-end.is-goal { border-color: var(--tg-accent); background: #fff; }

  /* Continue the pattern */
  .tg-row { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-top: var(--space-3); }
  .tg-cell { width: clamp(38px, 9.5vw, 58px); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 12px; font-size: clamp(1.3rem, 5vw, 2rem); line-height: 1; border: 3px solid transparent; }
  .tg-cell img { width: 80%; height: 80%; object-fit: contain; }
  .tg-cell.is-hole { background: transparent; border: 3px dashed color-mix(in srgb, var(--tg-accent2) 55%, transparent); color: var(--tg-accent2); font-weight: 700; }
  .tg-cell.is-now { border-style: solid; border-color: var(--tg-glow); box-shadow: 0 0 12px var(--tg-glow); }
  .tg-cell.is-filled { animation: tg-pop .3s ease-out; }

  /* Weave the basket */
  .tg-weave-wrap { display: flex; flex-wrap: wrap; gap: var(--space-5); justify-content: center; align-items: flex-end; margin-top: var(--space-3); }
  .tg-weave-wrap figure { margin: 0; text-align: center; }
  .tg-weave-wrap figcaption { font-weight: 700; color: var(--tg-accent2); margin-bottom: var(--space-2); }
  .tg-weave { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 4px; padding: 6px; background: #7a5230; border-radius: 12px; width: min(72vw, 300px); margin: 0 auto; }
  /* A woven Christmas heart: the grid is turned 45° (each square a diamond) and gets two round lobes, one in each colour. */
  .tg-heart { --s: min(46vw, 184px); position: relative; width: calc(var(--s) * 1.75); height: calc(var(--s) * 1.62); margin: 0 auto; filter: drop-shadow(0 2px 4px rgb(0 0 0 / .35)); }
  .tg-heart--small { --s: min(23vw, 88px); }
  .tg-heart .tg-weave { position: absolute; left: calc(50% - var(--s) / 2); top: calc(var(--s) * .37); width: var(--s); height: var(--s); margin: 0; padding: 0; gap: 3px; border-radius: 0; background: #e9dccb; transform: rotate(45deg); }
  .tg-heart .tg-weave::before, .tg-heart .tg-weave::after { content: ''; position: absolute; }
  .tg-heart .tg-weave::before { left: 0; bottom: 100%; width: 100%; height: 50%; border-radius: 999px 999px 0 0; background: var(--on); }
  .tg-heart .tg-weave::after { top: 0; right: 100%; width: 50%; height: 100%; border-radius: 999px 0 0 999px; background: var(--off); }
  .tg-sq { aspect-ratio: 1; border-radius: 6px; border: 2px solid rgba(0, 0, 0, .25); padding: 0; display: block; }
  button.tg-sq { cursor: pointer; }

  /* What changed? */
  .tg-shelf { cursor: default; }
  button.tg-shelf { cursor: pointer; }
  .tg-lvl-mester .tg-shelf { opacity: 1; }
  .tg-curtain { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: var(--space-4); background: color-mix(in srgb, var(--tg-sky) 92%, transparent); color: #fff; font: 700 clamp(1.1rem, 4vw, 1.6rem) var(--font-ui); animation: tg-pop .3s ease-out; }

  /* Light the lanterns */
  .tg-lantern { position: absolute; transform: translate(-50%, -50%); background: none; border: 0; padding: 4px; cursor: pointer; border-radius: 16px; display: flex; flex-direction: column; align-items: center; font-size: clamp(2rem, 9vw, 4rem); line-height: 1; filter: grayscale(1) brightness(.55); transition: filter .2s; }
  .tg-lantern img { width: clamp(44px, 12vw, 90px); height: auto; }
  .tg-lantern b { font: 700 clamp(.8rem, 2.6vw, 1.1rem) var(--font-ui); color: #fff; background: rgba(0, 0, 0, .5); border-radius: 999px; padding: 0 .6em; margin-top: 4px; }
  .tg-lantern.is-lit { filter: drop-shadow(0 0 14px var(--tg-glow)); }

  /* The show */
  .tg-slotpick { border: 0; padding: 0; margin-inline: 0; min-width: 0; }
  .tg-slotpick legend { font-weight: 700; font-size: 1.15rem; color: var(--tg-accent2); padding: 0; }
  .tg-slotpick .tg-cards { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .tg-slotpick .tg-cardbtn { min-height: 44px; padding: .35rem .9rem; font-size: 1rem; border-radius: 999px; }
  .tg-cardbtn.is-picked { border-color: var(--tg-accent2); background: color-mix(in srgb, var(--tg-glow) 35%, #fff); }
  .tg-cardbtn:disabled { opacity: .4; cursor: default; }

  .tg-msg { min-height: 2.2em; text-align: center; font-size: 1.2rem; font-weight: 700; color: var(--tg-accent2); }

  /* Fact and secret cards */
  .tg-fact { background: #fff; border-left: 6px solid var(--tg-glow); border-radius: 14px; padding: var(--space-4); font-size: 1.15rem; line-height: 1.55; }
  .tg-fact > * + * { margin-top: var(--space-2); }
  .tg-secret-body { background: #fff8e6; border: 2px dashed var(--tg-glow); border-radius: 14px; padding: var(--space-4); font-size: 1.1rem; line-height: 1.55; animation: tg-pop .3s ease-out; }
  .tg-secret-body > * + * { margin-top: var(--space-3); }
  .tg-age { display: inline-block; font-weight: 700; font-size: .95rem; color: var(--tg-accent2); background: #fff; border-radius: 999px; padding: .2rem .8rem; }
  .tg-video { margin: 0; }
  .tg-video-wrap { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #000; }
  .tg-video-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .tg-video figcaption { font-size: .95rem; color: var(--ink-mid); margin-top: var(--space-1); }
  .tg-clue { display: flex; align-items: center; justify-content: center; gap: var(--space-3); min-height: 3.2rem; margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: #fff; border-radius: 14px; font-size: 1.2rem; font-weight: 700; text-align: center; box-shadow: var(--shadow-sm); }
  .tg-clue p { margin: 0; }
  .tg-guessrow { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: center; gap: var(--space-2); margin-top: var(--space-3); }
