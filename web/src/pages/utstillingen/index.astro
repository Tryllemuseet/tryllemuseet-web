---
// src/pages/utstillingen/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import ContentCard from '../../components/ContentCard.astro'
import AnimateIn from '../../components/AnimateIn.astro'
import { getAllTemaer, getUtstillingDeepDives, getUtstillingPage, urlFor } from '../../lib/sanity'

const STAGGER_MS = 80
const STAGGER_CAP_MS = 320
const staggerDelay = (i: number) => Math.min(i * STAGGER_MS, STAGGER_CAP_MS)

const [temaer, exhibitions, page] = await Promise.all([
  getAllTemaer(),
  getUtstillingDeepDives(),
  getUtstillingPage(),
])

// Uferdig innhold («Kommer snart») er som hovedregel skjult i produksjon —
// forhåndsvisning/staging viser fortsatt alt, til redaksjonell kontroll.
// Et konkret kommende område kan likevel annonseres i produksjon ved å
// eksplisitt slå på showAsComingSoon i Sanity.
const isProdEnv = import.meta.env.PUBLIC_VERCEL_ENV === 'production'
const visibleSeksjoner = page.seksjoner.filter(s => !isProdEnv || s.ready || s.showAsComingSoon)
---

<BaseLayout
  title="Utstillingen — Tryllemuseet"
  description="Houdini er museets aktuelle utstilling — pluss et tilbakeblikk på tryllekunstens gullalder, fra Robert-Houdin til Kellar og Thurston."
>

  <!-- ── HERO ──────────────────────────────────────────────────────── -->
  <PageHero label={page.hero.eraLabel} title={page.hero.heading} intro={page.hero.ingress} theme="light" compact />
  <div class="container"><hr class="gold-rule" /></div>

  <!-- ── TEMAER ────────────────────────────────────────────────────── -->
  {temaer.length > 0 && (
    <section class="container tema-section">
      <AnimateIn><p class="section-label">{temaer.length > 1 ? 'Temaer' : 'Tema'}</p></AnimateIn>
      <div class="card-grid">
        {temaer.map((t, i) => {
          const imgUrl = t.heroImage?.asset
            ? urlFor(t.heroImage).width(700).height(500).format('webp').fit('crop').url()
            : undefined
          return (
            <AnimateIn delay={staggerDelay(i)}>
            <ContentCard
              imageUrl={imgUrl}
              imageAlt={t.heroImage?.alt ?? t.title}
              icon={imgUrl ? undefined : (t.icon ?? '✨')}
              title={t.title}
              description={t.intro}
              href={`/utstillingen/${t.slug}`}
              ctaText={`${t.content.length} ${t.content.length === 1 ? 'opplevelse' : 'opplevelser'} →`}
            />
            </AnimateIn>
          )
        })}
      </div>
    </section>
  )}

  <!-- ── AKTUELL UTSTILLING ────────────────────────────────────────── -->
  {exhibitions.length > 0 && (
    <section class="container aktuell-section">
      <AnimateIn><p class="section-label">{exhibitions.length > 1 ? 'Aktuelle utstillinger' : 'Aktuell utstilling'}</p></AnimateIn>
      <div class="aktuell-stack">
        {exhibitions.map((ex, i) => {
          const imgUrl = ex.mainImage?.asset
            ? urlFor(ex.mainImage).width(900).height(600).format('webp').fit('crop').url()
            : undefined
          return (
            <AnimateIn delay={staggerDelay(i)}>
            <ContentCard
              variant="dark"
              imageUrl={imgUrl}
              imageAlt={ex.mainImage?.alt ?? ex.title}
              icon={imgUrl ? undefined : '🎟️'}
              label={ex.stationCount > 0 ? `${ex.stationCount} ${ex.stationCount === 1 ? 'stasjon' : 'stasjoner'}` : undefined}
              title={ex.title}
              description={[ex.tagline, ex.detailIntro].filter(Boolean).join(' — ') || undefined}
              href={`/utstillingen/${ex.slug}`}
              ctaText="Se utstillingen →"
            />
            </AnimateIn>
          )
        })}
      </div>
    </section>
  )}

  <!-- ── DIVIDER ────────────────────────────────────────────────────── -->
  <div class="container"><hr class="gold-rule section-rule" /></div>

  <!-- ── KOMMENDE SEKSJONER ────────────────────────────────────────── -->
  {visibleSeksjoner.length > 0 && (
  <section class="container coming-section">
    <AnimateIn>
      <p class="section-label">{page.kommerSnartSeksjon.label}</p>
      <h2 class="display-title section-title">{page.kommerSnartSeksjon.heading}</h2>
    </AnimateIn>

    <div class="card-grid">
      {visibleSeksjoner.map((s, i) => (
        <AnimateIn delay={staggerDelay(i)}>
        <ContentCard
          variant="compact"
          icon={s.icon}
          label={s.label}
          title={s.title}
          description={s.description}
          href={s.ready ? `/utstillingen/${s.slug}` : undefined}
          ctaText={s.ready ? 'Utforsk →' : undefined}
          status={s.ready ? undefined : 'Kommer snart'}
        />
        </AnimateIn>
      ))}
    </div>
  </section>
  )}

  <div class="section-bottom-pad" />

</BaseLayout>

<style>
  /* ── CARD GRIDS (Temaer + Kommende seksjoner) ── */
  .tema-section { padding-bottom: 2.5rem; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  /* ── AKTUELL UTSTILLING ── */
  .aktuell-section { padding-bottom: 2.5rem; }
  .aktuell-section .section-label { margin-bottom: 1rem; }
  .aktuell-stack { display: flex; flex-direction: column; gap: 1.5rem; }

  /* ── SECTION RULE ── */
  .section-rule { margin: 1rem 0 3rem; }
  .section-title { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0.3rem 0 0.75rem; }

  /* ── COMING SECTIONS ── */
  .coming-section { padding-bottom: 1rem; }
  .coming-section .card-grid { grid-template-columns: repeat(2, 1fr); margin-top: 2rem; }

  /* ── BOTTOM PAD ── */
  .section-bottom-pad { height: 5rem; }

  /* ── RESPONSIVE ────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .coming-section .card-grid { grid-template-columns: 1fr; }
  }
</style>
