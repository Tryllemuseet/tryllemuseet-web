---
// src/pages/barn.astro
import BaseLayout from '../layouts/BaseLayout.astro'
import AnimateIn from '../components/AnimateIn.astro'
import PageHero from '../components/PageHero.astro'
import Button from '../components/Button.astro'
import { getBarnPage, getSiteConfig, getComicStoryPaths, portableTextToHtml } from '../lib/sanity'

const [bp, config, storyPaths] = await Promise.all([
  getBarnPage(),
  getSiteConfig(),
  getComicStoryPaths(),
])
// Houdini er høstens hovedutstilling og har den eneste ferdige interaktive
// historien akkurat nå — teaseren under peker rett dit så lenge den finnes,
// og faller tilbake til den generelle historier-oversikten ellers.
const hasHoudiniStory = storyPaths.some((p: { params: { slug: string } }) => p.params.slug === 'harry-houdini')

const hero = bp?.hero ?? {
  label: 'For barn og unge',
  heading: 'En magisk opplevelse',
  headingEm: 'for hele familien',
  ingress: 'Tryllemuseet byr på undring, humor og magi for alle aldre.',
  cta1Label: 'Se kommende kurs', cta1Href: '/aktiviteter',
  cta2Label: 'Book skolebesøk',  cta2Href: '/kontakt',
}
const aldersgrupper = bp?.aldersgrupper ?? []
const aktiviteter   = bp?.aktiviteter   ?? []
const skole         = bp?.skolebesok    ?? {
  label: 'For skoler og barnehager',
  heading: 'Pedagogisk opplegg for klasser',
  tekst: [],
  detaljer: [],
  knappLabel: 'Ta kontakt for booking',
  knappHref: '/kontakt',
}
const skoleHtml = portableTextToHtml(skole.tekst)
const kurs = bp?.kursBanner ?? {
  heading: 'Tryllekurs for barn',
  tekst: '',
  knappLabel: 'Se alle arrangementer',
  knappHref: '/aktiviteter',
}

// «Lær et triks» er ikke lansert i produksjon ennå (se siteConfig.laerEtTriksActive)
// — redaktørinnholdet i hero.cta2 peker dit i dag, så skjul den knappen mens
// funksjonen er av i stedet for å la den peke til en uannonsert side.
const showCta2 = hero.cta2Href && (config.laerEtTriksActive || !hero.cta2Href.startsWith('/barn/laer-et-triks'))
---

<BaseLayout
  title="Barn og unge — Tryllemuseet"
  description="Tryllemuseet er et magisk sted for barn og unge. Lær triks, utforsk historien og opplev magien!"
>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <PageHero label={hero.label} title={`${hero.heading} ${hero.headingEm}`} intro={hero.ingress} theme="dark">
    <Button variant="secondary" href={hero.cta1Href}>{hero.cta1Label}</Button>
    {showCta2 && <Button variant="outline" href={hero.cta2Href} class="hero-btn-outline">{hero.cta2Label}</Button>}
  </PageHero>

  <!-- ── LÆR ET TRIKS (teaser) ────────────────────────────────── -->
  {config.laerEtTriksActive && (
    <section class="triks-teaser section-pad">
      <AnimateIn>
      <div class="container triks-teaser-inner">
        <div>
          <span class="etikett">Prøv selv</span>
          <h2>Lær et triks</h2>
          <p>Noen enkle trylletriks du kan øve på hjemme og vise fram til familie og venner.</p>
        </div>
        <Button variant="primary" href="/barn/laer-et-triks">Se triksene</Button>
      </div>
      </AnimateIn>
    </section>
  )}

  <!-- ── INTERAKTIVE HISTORIER (teaser) ──────────────────────────── -->
  <section class="triks-teaser section-pad">
    <AnimateIn>
    <div class="container triks-teaser-inner">
      <div>
        <span class="etikett">Bla, lytt og oppdag</span>
        <h2>{hasHoudiniStory ? 'Møt Houdini' : 'Interaktive historier'}</h2>
        <p>
          {hasHoudiniStory
            ? 'Opplev historien om verdens mest berømte utbryterkonge – scene for scene, med bilder, opplesning og interaktive elementer.'
            : 'Opplev magihistorien scene for scene, med opplesning, tidslinje og klikkbare gjenstander.'}
        </p>
      </div>
      <Button variant="primary" href={hasHoudiniStory ? '/barn/historier/harry-houdini' : '/barn/historier'}>
        {hasHoudiniStory ? 'Opplev Houdinis historie →' : 'Se historiene'}
      </Button>
    </div>
    </AnimateIn>
  </section>

  <!-- ── ALDERSGRUPPER ────────────────────────────────────────── -->
  {aldersgrupper.length > 0 && (
    <section class="aldersgrupper section-pad">
      <div class="container">
        <AnimateIn direction="up"><h2 class="section-title">Noe for alle aldre</h2></AnimateIn>
        <AnimateIn direction="up">
        <div class="alder-grid">
          {aldersgrupper.map(a => (
            <div class="alder-kort">
              <div class="alder-ikon">{a.ikon}</div>
              <h3>{a.alder}</h3>
              <p>{a.tekst}</p>
            </div>
          ))}
        </div>
        </AnimateIn>
      </div>
    </section>
  )}

  <!-- ── AKTIVITETER ──────────────────────────────────────────── -->
  {aktiviteter.length > 0 && (
    <section class="aktiviteter section-pad bg-cream">
      <div class="container">
        <AnimateIn direction="up"><h2 class="section-title">Hva skjer på museet?</h2></AnimateIn>
        <AnimateIn direction="up">
        <div class="aktivitet-grid">
          {aktiviteter.map(a => (
            <div class="aktivitet-kort">
              <div class="aktivitet-ikon">{a.ikon}</div>
              <h3>{a.tittel}</h3>
              <p>{a.beskrivelse}</p>
            </div>
          ))}
        </div>
        </AnimateIn>
      </div>
    </section>
  )}

  <!-- ── SKOLEBESØK ───────────────────────────────────────────── -->
  <section class="skolebesok section-pad">
    <div class="container skolebesok-layout">
      <AnimateIn direction="left">
      <div class="skolebesok-tekst">
        <span class="etikett">{skole.label}</span>
        <h2>{skole.heading}</h2>
        <Fragment set:html={skoleHtml} />
        {skole.detaljer.length > 0 && (
          <ul class="sjekkliste">
            {skole.detaljer.map(d => <li>{d}</li>)}
          </ul>
        )}
        <Button variant="primary" href={skole.knappHref}>{skole.knappLabel}</Button>
      </div>
      </AnimateIn>
      <AnimateIn direction="right">
      <div class="skolebesok-bilde">
        <div class="skole-medaljong" aria-hidden="true">
          <div class="skole-medaljong-ring">
            <span class="skole-medaljong-ikon">🎩</span>
          </div>
          <p class="skole-medaljong-tekst">Pedagogisk opplegg<br />for klasser og barnehager</p>
        </div>
      </div>
      </AnimateIn>
    </div>
  </section>

  <!-- ── KURSBANNER ───────────────────────────────────────────── -->
  <section class="kurs-banner">
    <AnimateIn>
    <div class="container kurs-banner-inner">
      <div>
        <h2>{kurs.heading}</h2>
        <p>{kurs.tekst}</p>
      </div>
      <Button variant="secondary" href={kurs.knappHref}>{kurs.knappLabel}</Button>
    </div>
    </AnimateIn>
  </section>

</BaseLayout>

<style>
  :global(.hero-btn-outline) { border-color: rgba(212,168,67,0.5); color: var(--cream); }
  :global(.hero-btn-outline:hover) { border-color: var(--gold); color: var(--gold); background: transparent; }

  /* ── Sections ── */
  .section-pad { padding-block: 5rem; }
  .bg-cream { background: var(--cream); }

  /* ── Triks-teaser ── */
  .triks-teaser { background: white; border-bottom: 1px solid rgba(107,15,26,0.08); }
  .triks-teaser-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .triks-teaser h2 { font-family: var(--font-display); font-size: 1.6rem; color: var(--burgundy); margin: 0.3rem 0 0.5rem; }
  .triks-teaser p { font-family: var(--font-body); font-size: 1rem; color: #555; max-width: 480px; line-height: 1.6; }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--burgundy);
    text-align: center;
    margin-bottom: 3rem;
  }
  .section-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 2px;
    background: var(--gold);
    margin: 0.8rem auto 0;
  }

  /* ── Aldersgrupper ── */
  .alder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }
  .alder-kort {
    text-align: center;
    padding: 2.5rem 2rem;
    border: 1px solid rgba(107,15,26,0.12);
    border-radius: 4px;
    background: white;
    transition: box-shadow 0.2s;
  }
  .alder-kort:hover { box-shadow: 0 8px 32px rgba(107,15,26,0.1); }
  .alder-ikon { font-size: 2.5rem; margin-bottom: 1rem; }
  .alder-kort h3 { font-family: var(--font-display); font-size: 1.1rem; color: var(--burgundy); margin-bottom: 0.75rem; }
  .alder-kort p  { font-family: var(--font-body); font-size: 0.95rem; color: #555; line-height: 1.65; }

  /* ── Aktiviteter ── */
  .aktivitet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .aktivitet-kort {
    padding: 2rem 1.5rem;
    background: white;
    border-radius: 4px;
    border-top: 3px solid var(--gold);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .aktivitet-ikon { font-size: 2rem; margin-bottom: 1rem; }
  .aktivitet-kort h3 { font-family: var(--font-display); font-size: 1rem; color: var(--burgundy); margin-bottom: 0.6rem; }
  .aktivitet-kort p  { font-family: var(--font-ui); font-size: 0.95rem; color: #555; line-height: 1.6; }

  /* ── Skolebesøk ── */
  .skolebesok { background: white; }
  .skolebesok-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .etikett {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    border-bottom: 1px solid var(--gold);
    padding-bottom: 0.2em;
    margin-bottom: 1rem;
  }
  .skolebesok-tekst h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--burgundy);
    line-height: 1.3;
    margin-bottom: 1rem;
  }
  .skolebesok-tekst p {
    font-family: var(--font-body);
    font-size: 1rem;
    color: #444;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .sjekkliste { list-style: none; padding: 0; margin-bottom: 2rem; }
  .sjekkliste li {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: #444;
    padding: 0.4em 0 0.4em 1.6em;
    position: relative;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .sjekkliste li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 0.7rem;
    top: 0.55em;
  }
  .skole-medaljong {
    aspect-ratio: 4/3;
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 15%, rgba(212,168,67,0.16), transparent 45%),
      radial-gradient(circle at 80% 85%, rgba(212,168,67,0.12), transparent 45%),
      radial-gradient(rgba(212,168,67,0.35) 1px, transparent 1.5px) 0 0/28px 28px,
      linear-gradient(135deg, var(--burgundy) 0%, #3d050e 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }
  .skole-medaljong-ring {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    border: 2px solid var(--gold);
    box-shadow: 0 0 0 6px rgba(212,168,67,0.18), 0 8px 24px rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(212,168,67,0.08);
  }
  .skole-medaljong-ikon { font-size: 2.75rem; }
  .skole-medaljong-tekst {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.5;
    text-align: center;
    color: var(--gold-light, var(--cream));
    max-width: 14rem;
  }

  /* ── Kursbanner ── */
  .kurs-banner { background: var(--burgundy); padding-block: 3.5rem; }
  .kurs-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .kurs-banner h2 { font-family: var(--font-display); font-size: 1.6rem; color: var(--cream); margin-bottom: 0.5rem; }
  .kurs-banner p  { font-family: var(--font-body); font-size: 1rem; color: rgba(251,247,239,0.75); max-width: 560px; line-height: 1.6; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .skolebesok-layout { grid-template-columns: 1fr; }
    .skolebesok-bilde { display: none; }
  }
</style>
