    // Which room each tale belongs to is known only to the server. On
    // Lærlingens vei the rooms are labelled with their principles (also from
    // the server: they are the earlier rooms' solutions).
    interface VhRoom { key: string; name: string }
    const VH_ROOMS: VhRoom[] = lang === 'en' ? [
      { key: 'sand',   name: 'The Sand Room' },
      { key: 'marked', name: 'The Market Square' },
      { key: 'salong', name: 'The Salon' },
      { key: 'seanse', name: 'The Séance' },
      { key: 'teater', name: 'The Theatre' },
      { key: 'kino',   name: 'The Cinema' },
    ] : [
      { key: 'sand',   name: 'Sandrommet' },
      { key: 'marked', name: 'Markedsplassen' },
      { key: 'salong', name: 'Salongen' },
      { key: 'seanse', name: 'Seansen' },
      { key: 'teater', name: 'Teateret' },
      { key: 'kino',   name: 'Kinoen' },
    ]
    const VH_SCENARIOS = lang === 'en' ? [
      'A “thinking machine” beats everyone at chess at the world exhibition.',
      'In pitch darkness the table lifts — and everyone around it feels it.',
      'On the screen, the hero floats into the air — with no cut to be seen.',
      'The escape artist lets the house “choose” the trunk he will be locked into.',
    ] : [
      'En «tenkende maskin» slår alle i sjakk på verdensutstillingen.',
      'I stummende mørke letter bordet — og alle rundt det kjenner det.',
      'På lerretet svever helten til værs — uten et klipp å se.',
      'Utbryteren lar salen «velge» kisten han skal låses inn i.',
    ]
    let vhPath = state.path['vinterhagen'] || ''
    let vhHintsUsed = 0
    let vhWrong = 0
    let vhSelected = -1
    let vhMatched: Array<[number, string]> = []   // [tale, room key]
    let vhPrinciples: Record<string, string> = {}
    let vhBusy = false

    wireHints('vh-hint-btn', 'vh-hints', 'vinterhagen', () => { vhHintsUsed++ })

    function vhRender() {
      const sc = $('vh-scen')
      const rm = $('vh-rooms')
      sc.innerHTML = ''
      rm.innerHTML = ''
      VH_SCENARIOS.forEach((text, i) => {
        const done = vhMatched.some(m => m[0] === i)
        const btn = document.createElement('button')
        btn.className = 'match-item'
        btn.textContent = text
        btn.disabled = done
        if (done) btn.classList.add('match-item--done')
        if (vhSelected === i) btn.classList.add('match-item--selected')
        btn.addEventListener('click', () => {
          vhSelected = vhSelected === i ? -1 : i
          vhRender()
        })
        sc.appendChild(btn)
      })
      for (const room of VH_ROOMS) {
        const used = vhMatched.some(m => m[1] === room.key)
        const btn = document.createElement('button')
        btn.className = 'match-item match-item--secret'
        const principle = vhPath === 'mester' ? '' : vhPrinciples[room.key] ?? ''
        btn.textContent = room.name
        if (principle) {
          const small = document.createElement('small')
          small.textContent = principle
          btn.append(document.createElement('br'), small)
        }
        btn.disabled = used
        if (used) btn.classList.add('match-item--done')
        btn.addEventListener('click', async () => {
          if (vhSelected < 0) {
            $('vh-msg').textContent = t('Velg en fortelling først — så rommet den hører hjemme i.', 'Choose a tale first — then the room it belongs to.')
            return
          }
          if (vhBusy) return
          vhBusy = true
          const pair: [number, string] = [vhSelected, room.key]
          const r = await check('vinterhagen', { pairs: [...vhMatched, pair] })
          vhBusy = false
          if (!r) return
          vhSelected = -1
          $('vh-msg').textContent = r.msg ?? ''
          if (r.ok) vhMatched.push(pair)
          else vhWrong++
          vhRender()
          if (r.solved) {
            solveRoom('vh', 12, t('Sigillet fra Vinterhagen', 'The seal of the Winter Garden'),
              vhPath === 'mester' && vhHintsUsed === 0 && vhWrong === 0, r.solved)
          }
        })
        rm.appendChild(btn)
      }
    }

