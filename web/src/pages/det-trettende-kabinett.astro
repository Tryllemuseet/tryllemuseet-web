<script>
  interface GFact { text: string; linkUrl?: string; linkLabel?: string; imageUrl?: string; imageAlt?: string }
  interface GRoomLang { title: string; introHtml: string }
  interface GRoom { nb: GRoomLang; en: GRoomLang; imageUrl?: string; imageAlt?: string; imageAltEn?: string; imageSrcSet?: string; imageWidth?: number; imageHeight?: number; curiosityUrl?: string }
  interface GHeroLang { title: string; intro: string }
  interface GData {
    directors: Record<string, string>
    rooms: Record<string, GRoom>
    museumAddress?: string
    englishEnabled?: boolean
    hero?: { nb: GHeroLang; en: GHeroLang }
  }

  const dataEl = document.getElementById('kabinett-data')
  if (dataEl) {
    const data: GData = JSON.parse(dataEl.textContent ?? '{}')

    const $ = (id: string) => document.getElementById(id)!
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const sleep = (ms: number) => new Promise(r => setTimeout(r, reducedMotion ? Math.min(ms, 120) : ms))

    // ── Språk ────────────────────────────────────────────────────
    // The whole game runs in one language per page load; switching
    // reloads the page (progress lives in localStorage anyway).
    const englishEnabled = data.englishEnabled === true
    let storedLang: string | null = null
    try { storedLang = localStorage.getItem('kabinett-lang') } catch { /* ignore */ }
    const lang: 'nb' | 'en' = englishEnabled && storedLang === 'en' ? 'en' : 'nb'
    const t = (nb: string, en: string) => (lang === 'en' ? en : nb)
    const R = (key: string): GRoomLang | undefined => {
      const r = data.rooms[key]
      return r ? (lang === 'en' ? r.en : r.nb) : undefined
    }
    const roomTitle = (key: string) => R(key)?.title || key

    // ── Svarskranken (/api/kabinett) ─────────────────────────────
    // This page carries no answers, hints, explanations or facts: the server
    // checks every answer and hands those out (src/lib/kabinett.ts) — the
    // explanation and facts of a puzzle room only after a correct answer.
    interface GSolution { html: string; facts: GFact[]; imageUrl?: string; imageAlt?: string }
    interface GCheck { ok: boolean; msg?: string; early?: boolean; invalid?: boolean; solved?: GSolution }
    interface GStart { lines: Record<string, string>; answer?: string }

    async function ask<T>(body: Record<string, unknown>): Promise<T | null> {
      try {
        const res = await fetch('/api/kabinett', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...body, lang }),
        })
        if (!res.ok) throw new Error(`HTTP ${res.status}`)
        return (await res.json()) as T
      } catch {
        toast(t(
          'Kabinettet svarer ikke akkurat nå. Prøv igjen om et øyeblikk.',
          'The Cabinet is not answering right now. Try again in a moment.',
        ))
        return null
      }
    }
    const check = async (room: string, answer: Record<string, unknown> = {}) => {
      const result = await ask<GCheck>({ action: 'check', room, ...answer })
      if (result && Object.keys(answer).length) setDirector(room, result.solved ? 'solved' : result.ok ? 'point' : 'think')
      return result
    }

    // A decorative portrait beside the copy, never over a puzzle or an illusion.
    function setDirector(room: string, pose: string) {
      const scene = document.getElementById(`sc-${room}`)
      const figure = scene?.querySelector<HTMLElement>('.director-portrait')
      const img = figure?.querySelector<HTMLImageElement>('img')
      const url = data.directors?.[pose]
      if (!figure || !img || !url) return
      img.src = url
      figure.hidden = false
    }

    // The texts a room needs when it opens (the Director's whisper for the
    // chosen path etc.), fetched once per room.
    const startCache = new Map<string, Promise<GStart | null>>()
    function roomStart(room: string): Promise<GStart | null> {
      let p = startCache.get(room)
      if (!p) {
        p = ask<GStart>({ action: 'start', room }).then(r => {
          if (!r) startCache.delete(room) // let the next attempt retry
          return r
        })
        startCache.set(room, p)
      }
      return p
    }
    const roomLine = async (room: string, key: string) => (await roomStart(room))?.lines[key] ?? ''

    const langBtn = $('lang-btn') as HTMLButtonElement
    if (englishEnabled) {
      langBtn.hidden = false
      langBtn.textContent = lang === 'en' ? 'På norsk' : 'In English'
      langBtn.setAttribute('lang', lang === 'en' ? 'no' : 'en')
      langBtn.addEventListener('click', () => {
        try { localStorage.setItem('kabinett-lang', lang === 'en' ? 'nb' : 'en') } catch { /* ignore */ }
        location.reload()
      })
    }

