---
// src/pages/det-trettende-kabinett.astro
// "Det trettende kabinett" — the museum's story game.
// Concept: docs/det-trettende-kabinett-concept.md. The puzzle mechanics live
// here; the answers do NOT. Room copy, answer keys, hints, explanations and
// facts are gameChapter documents in the private "lukket" dataset. This page
// only gets each room's title, intro and image; everything else comes from
// /api/kabinett (src/lib/kabinett.ts) while the game is played — the
// explanation and facts of a puzzle room only after a correct answer.
// All room copy exists in Norwegian and English; the English version is
// exposed in-game once gameConfig.englishEnabled is on.
//
// Rendered on demand (it reads the private dataset at request time, so
// editors' changes show up without a rebuild) and cached briefly at the CDN.
//
// While the game is switched off, ?forhandsvisning=<code> opens it for one
// browser (src/lib/kabinettPreview.ts); the page is then never cached.
export const prerender = false

import BaseLayout from '../layouts/BaseLayout.astro'
import art from '../lib/kabinett-art.json'
import { getGameConfig, getGamePreview, getAllGameChapters, getSiteConfig, privateUrlFor, portableTextToHtml } from '../lib/sanity'
import { getPrivateClient, failedAttemptDelay } from '../lib/bakTeppet'
import {
  PREVIEW_PARAM,
  activePreviewCode,
  codeMatches,
  grantPreview,
  hasPreviewAccess,
  hasPreviewCookie,
} from '../lib/kabinettPreview'

const [config, siteConfig] = await Promise.all([getGameConfig(), getSiteConfig()])

const priv = getPrivateClient()
let preview = false
if (config?.isActive !== true && priv) {
  // Only visitors with the link or the cookie cost a Sanity request.
  const typed = Astro.url.searchParams.get(PREVIEW_PARAM)
  if (typed !== null || hasPreviewCookie(Astro.cookies)) {
    let code: string | null = null
    try {
      code = activePreviewCode(await getGamePreview(priv.client))
    } catch (err) {
      console.error('[kabinett] could not load the preview settings', err)
    }
    if (typed !== null) {
      if (codeMatches(typed, code)) {
        grantPreview(Astro.cookies, priv.token, code!, Astro.url.protocol === 'https:')
        // Redirect so the code never stays in the address bar or history.
        return Astro.redirect(Astro.url.pathname, 303)
      }
      await failedAttemptDelay()
    }
    preview = hasPreviewAccess(Astro.cookies, priv.token, code)
  }
}

const isActive = config?.isActive === true || preview
let chapters: Awaited<ReturnType<typeof getAllGameChapters>> = []
let unavailable = false
if (isActive) {
  try {
    if (!priv) throw new Error('SANITY_PRIVATE_READ_TOKEN is not set')
    chapters = await getAllGameChapters(priv.client)
  } catch (err) {
    console.error('[kabinett] could not load the rooms', err)
    unavailable = true
  }
}

if (unavailable) {
  Astro.response.status = 503
  Astro.response.headers.set('Cache-Control', 'no-store')
} else if (!isActive || preview) {
  // Not cached while the game is off: the CDN ignores cookies, so a cached
  // "coming soon" page would hide the game from a preview browser (and a
  // cached preview page would show it to everyone).
  Astro.response.headers.set('Cache-Control', 'private, no-store')
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=600')
}

const comingSoonTitle = unavailable
  ? 'Kabinettet er stengt et øyeblikk …'
  : (config?.comingSoonTitle ?? 'Dørene er ennå låst …')
const comingSoonText = unavailable
  ? 'Noe har gått galt bak forhenget. Prøv igjen om litt.'
  : (config?.comingSoonText ??
    'Det trettende kabinett åpner snart for sin neste lærling. Kom tilbake litt senere — eller besøk oss på Årvoll gård i mellomtiden!')

const gameTitle = config?.title ?? 'Det trettende kabinett'
const gameIntro = config?.intro ??
  'Et tryllemuseum som bare finnes mellom midnatt og daggry. Direktøren tar opp én lærling per generasjon — og i natt står dørene åpne.'

// ── Text helpers ──────────────────────────────────────────────────
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')

// Plain text (the simple intro fields) → paragraphs.
const plainToHtml = (s: string) =>
  s
    .split(/\n{2,}/)
    .filter(p => p.trim())
    .map(p => `<p>${escapeHtml(p).replace(/\n/g, '<br>')}</p>`)
    .join('')

// What the game engine receives per room and language: only what is shown
// before the room is solved.
interface RoomLang { title: string; introHtml: string }
interface RoomPayload { nb: RoomLang; en: RoomLang; imageUrl?: string; imageAlt?: string; imageAltEn?: string; imageSrcSet?: string; imageWidth?: number; imageHeight?: number; curiosityUrl?: string }

const rooms: Record<string, RoomPayload> = Object.fromEntries(
  Object.entries(art.rooms).map(([key, image]) => [key, {
    nb: { title: '', introHtml: '' }, en: { title: '', introHtml: '' }, ...image,
  }]),
)
for (const c of chapters) {
  const introNbHtml = portableTextToHtml(c.introRich, privateUrlFor) || plainToHtml(c.intro || '')
  rooms[c.key] = {
    nb: { title: c.title || '', introHtml: introNbHtml },
    // Missing English falls back to the Norwegian copy.
    en: {
      title: c.titleEn || c.title || '',
      introHtml: portableTextToHtml(c.introRichEn, privateUrlFor) || (c.introEn ? plainToHtml(c.introEn) : introNbHtml),
    },
    ...(art.rooms[c.key as keyof typeof art.rooms] ?? {}),
    ...(c.curiosityImage?.asset ? { curiosityUrl: privateUrlFor(c.curiosityImage).width(120).format('webp').url() } : {}),
    ...(c.image?.asset
      ? {
          imageUrl: privateUrlFor(c.image).width(1280).format('webp').url(),
          imageSrcSet: `${privateUrlFor(c.image).width(760).format('webp').url()} 760w, ${privateUrlFor(c.image).width(1280).format('webp').url()} 1280w`,
          imageWidth: undefined, imageHeight: undefined,
          imageAlt: c.image.alt || '',
          imageAltEn: c.image.altEn || c.image.alt || '',
        }
      : {}),
  }
}
const nb = (key: string): RoomLang => rooms[key]?.nb ?? { title: '', introHtml: '' }

const englishEnabled = config?.englishEnabled === true
const gameTitleEn = config?.titleEn || 'Det trettende kabinett'
const gameIntroEn = config?.introEn ||
  'A magic museum that only exists between midnight and dawn. The Director takes on one apprentice per generation — and tonight, the doors stand open.'

const museumAddress = siteConfig?.address || 'Årvoll gård, Årvollveien 35\n0590 Oslo'
const payload = {
  rooms,
  directors: art.directors,
  museumAddress,
  englishEnabled,
  hero: {
    nb: { title: gameTitle, intro: gameIntro },
    en: { title: gameTitleEn, intro: gameIntroEn },
  },
}
// <-escape so a literal "</script>" in content can never break the page
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c')
---

<BaseLayout
  title={`${gameTitle} — Tryllemuseet`}
  description="Et tryllemuseum som bare finnes om natten. Løs gåtene, samle kortstokken og bli Direktørens lærling — Tryllemuseets historiespill."
  noindex={config?.isActive !== true}
>

  <section class="hero" id="game-hero">
    <div class="container">
      <p class="section-label">Tryllemuseet presenterer</p>
      <h1 class="display-title">{gameTitle}</h1>
      <p class="hero-sub">{gameIntro}</p>
    </div>
  </section>

  {!isActive || unavailable ? (
    <main class="container game-main">
      <div class="coming-soon">
        <span class="coming-soon-icon" aria-hidden="true">🚪🕯️</span>
        <h2>{comingSoonTitle}</h2>
        <p>{comingSoonText}</p>
        <a href="/utstillingen" class="btn-gold">Utforsk utstillingen →</a>
      </div>
    </main>
  ) : (
    <main class="container game-main" id="game-root">
      {preview && (
        <p class="preview-banner" role="status">
          🔑 Forhåndsvisning: spillet er ikke åpnet for publikum ennå. Bare nettlesere som har brukt forhåndsvisningslenken, ser dette.
        </p>
      )}
      <noscript>
        <div class="coming-soon">
          <h2>Kabinettet trenger JavaScript</h2>
          <p>Spillet er en interaktiv opplevelse og krever at JavaScript er slått på i nettleseren.</p>
        </div>
      </noscript>

      <!-- ── SPILL-LINJE ─────────────────────────────────────────── -->
      <div class="gamebar">
        <div class="gamebar-group">
          <button class="gamebar-btn" id="deck-btn" aria-haspopup="dialog">🃏 Kortstokken <span id="deck-count">0/12</span></button>
          <button class="gamebar-btn" id="help-btn" aria-haspopup="dialog">❔ Hjelp</button>
          <button class="gamebar-btn" id="lang-btn" hidden>In English</button>
        </div>
        <button class="gamebar-btn gamebar-btn--quiet" id="restart-btn">Begynn på nytt</button>
      </div>

      <!-- ── SCENE: BREVET ───────────────────────────────────────── -->
      <section class="scene scene--letter" id="sc-brevet" aria-labelledby="brevet-heading">
        <div class="letter">
          <p class="letter-seal" aria-hidden="true">🕯️</p>
          <h2 id="brevet-heading" class="letter-heading">Et forseglet brev</h2>
          <p class="letter-body">
            «Til den som finner dette: Kabinettet åpner i natt, mellom midnatt og daggry.
            Direktøren tar opp én lærling per generasjon. Tolv rom kjenner vi.
            Det trettende har ingen lærling noensinne funnet.
            Ta med deg et navn du tør å skrive, og bank tre ganger.»
          </p>
          <p class="letter-sign">— uleselig signatur, men blekket er ferskt</p>
          <button class="btn-gold" id="btn-knock">Bank på porten 🚪</button>
        </div>
      </section>

      <!-- ── SCENE: FOAJEEN ──────────────────────────────────────── -->
      <section class="scene" id="sc-foajeen" hidden aria-labelledby="fj-heading">
        <p class="scene-label">Første rom · Essene</p>
        <h2 class="scene-heading" id="fj-heading">{nb('foajeen').title}</h2>
        <div class="scene-intro" set:html={nb('foajeen').introHtml} />

        <div class="panel">
          <div class="guestbook" id="fj-book" aria-live="polite">
            <p class="guestbook-label">Gjesteboken</p>
            <p class="guestbook-line" id="fj-book-line">&nbsp;</p>
          </div>

          <form id="fj-form">
            <label class="field-label" for="fj-name">Scenenavnet ditt</label>
            <div class="field-row">
              <input type="text" id="fj-name" maxlength="24" autocomplete="off" placeholder="Den store …" required />
              <button type="submit" class="btn-gold" id="fj-write">Skriv med fjærpennen ✒️</button>
            </div>
          </form>

          <div id="fj-aces" hidden>
            <p class="game-msg game-msg--good">Fjærpennen skriver navnet ditt inn i boken, helt av seg selv. Direktøren trekker fire kort fram fra frakkeermet og rekker deg dem — <strong>essene</strong>. «Resten av stokken må du gjøre deg fortjent til.»</p>
            <div class="card-row" id="fj-aces-cards" aria-label="Fire ess"></div>
            <button class="btn-gold" id="fj-continue">Ta imot kortene og gå videre →</button>
          </div>
        </div>
      </section>

      <!-- ── SCENE: SANDROMMET ───────────────────────────────────── -->
      <section class="scene" id="sc-sandrommet" hidden aria-labelledby="sr-heading">
        <p class="scene-label">Andre rom · Toerne</p>
        <h2 class="scene-heading" id="sr-heading">{nb('sandrommet').title}</h2>
        <div class="scene-intro" set:html={nb('sandrommet').introHtml} />

        <div class="panel" id="sr-pathchoice">
          <p class="field-label">Velg din vei gjennom rommet</p>
          <div class="path-row">
            <button class="path-btn" data-scene="sr" data-path="laerling">
              <strong>Lærlingens vei</strong>
              <span>Rolig tempo og hjelp underveis</span>
            </button>
            <button class="path-btn" data-scene="sr" data-path="mester">
              <strong>Mesterens vei</strong>
              <span>Raskere stokking, ingen slingring — løser du gåten uten hint, gylles sparkortet ditt</span>
            </button>
          </div>
        </div>

        <div class="panel" id="sr-game" hidden>
          <p class="round-label" id="sr-round-label"></p>
          <div class="cup-stage" id="sr-stage">
            <button class="cup" data-cup="0" disabled><span class="cup-glyph" aria-hidden="true">🏺</span><span class="cup-ball" hidden aria-hidden="true">⚪</span><span class="sr-only-label">Kopp</span></button>
            <button class="cup" data-cup="1" disabled><span class="cup-glyph" aria-hidden="true">🏺</span><span class="cup-ball" hidden aria-hidden="true">⚪</span><span class="sr-only-label">Kopp</span></button>
            <button class="cup" data-cup="2" disabled><span class="cup-glyph" aria-hidden="true">🏺</span><span class="cup-ball" hidden aria-hidden="true">⚪</span><span class="sr-only-label">Kopp</span></button>
            <button class="cup cup--hand" id="sr-hand" hidden disabled><span class="cup-glyph" aria-hidden="true">✋</span><span class="sr-only-label">Magikerens hånd</span></button>
          </div>
          <button class="curiosity" id="sr-scarab" hidden aria-label="En skarabé piler over bordet">🪲</button>
          <p class="game-msg" id="sr-msg" aria-live="polite"></p>
          <ol class="swap-log" id="sr-log" aria-live="polite" aria-label="Stokkeloggen"></ol>

          <div class="hintbox">
            <button class="btn-quiet" id="sr-hint-btn" hidden>Direktørens hvisken (hint) 🤫</button>
            <ul class="hint-list" id="sr-hints"></ul>
          </div>
        </div>

        <div class="panel panel--solved" id="sr-solved" hidden>
          <p class="solved-title">✨ Gåten er løst</p>
          <div class="principle" id="sr-solution"></div>
          <div class="facts" id="sr-facts"></div>
          <button class="btn-gold" id="sr-complete">Fullfør rommet →</button>
        </div>
      </section>

      <!-- ── SCENE: SPEILGANGEN ──────────────────────────────────── -->
      <section class="scene" id="sc-speilgangen" hidden aria-labelledby="sg-heading">
        <p class="scene-label">Mellomrommet · Ruter to</p>
        <h2 class="scene-heading" id="sg-heading">{nb('speilgangen').title}</h2>
        <div class="scene-intro" set:html={nb('speilgangen').introHtml} />

        <div class="panel">
          <div id="sg-step1">
            <p class="game-msg">Speilet viser seks kort. <strong>Velg ett av dem — bare i tankene.</strong> Ikke pek, ikke klikk. Stirr på kortet ditt til du er sikker på at du husker det.</p>
            <div class="card-row card-row--big" id="sg-cards"></div>
            <button class="btn-gold" id="sg-memorized">Jeg har memorert kortet mitt</button>
          </div>

          <div id="sg-step2" hidden>
            <p class="game-msg game-msg--think" id="sg-thinking">Speilet dugger til … Kabinettet gransker tankene dine …</p>
          </div>

          <div id="sg-step3" hidden>
            <p class="game-msg game-msg--good"><strong>Kortet ditt er borte.</strong> Speilet har fjernet nøyaktig det kortet du tenkte på:</p>
            <div class="card-row card-row--big" id="sg-cards-after"></div>
            <div class="btn-row">
              <button class="btn-gold" id="sg-again">Utrolig — gjør det igjen 🔁</button>
              <button class="btn-quiet" id="sg-reveal-btn">Løft forhenget: hvordan? 🎭</button>
            </div>
            <div class="reveal" id="sg-reveal" hidden>
              <div class="reveal-text" id="sg-solution"></div>
              <div class="reveal-compare" id="sg-compare"></div>
              <div class="facts" id="sg-facts"></div>
            </div>
            <button class="btn-gold" id="sg-continue" hidden>Videre til neste rom →</button>
          </div>
        </div>
      </section>

      <!-- ── SCENE: MARKEDSPLASSEN ───────────────────────────────── -->
      <section class="scene" id="sc-markedsplassen" hidden aria-labelledby="mp-heading">
        <p class="scene-label">Tredje rom · Treerne</p>
        <h2 class="scene-heading" id="mp-heading">{nb('markedsplassen').title}</h2>
        <div class="scene-intro" set:html={nb('markedsplassen').introHtml} />

        <div class="panel" id="mp-pathchoice">
          <p class="field-label">Velg din vei gjennom rommet</p>
          <div class="path-row">
            <button class="path-btn" data-scene="mp" data-path="laerling">
              <strong>Lærlingens vei</strong>
              <span>Direktøren minner deg om hvor gjøglere gjemmer hemmeligheter</span>
            </button>
            <button class="path-btn" data-scene="mp" data-path="mester">
              <strong>Mesterens vei</strong>
              <span>Bare verset og ørene dine — løser du gåten uten hint, gylles sparkortet ditt</span>
            </button>
          </div>
        </div>

        <div class="panel" id="mp-game" hidden>
          <p class="game-msg" id="mp-pretext"></p>
          <blockquote class="verse" id="mp-verse">
            <p>Mine damer og herrer, kom nærmere nå!</p>
            <p>Ingen har øyne som klarer å slå</p>
            <p>Den flinkeste hånd på torget i dag.</p>
            <p>Tre krus og en ert — et lurendreiers slag!</p>
            <p>Ei skal dere tro det dere <em>ser</em>,</p>
            <p>Nei — hør etter nøye, så vinner du mer!</p>
          </blockquote>
          <p class="game-msg">Under hvilket krus ligger erten? Gjøgleren har allerede røpet det — for den som legger merke til det.</p>
          <div class="mp-cups">
            <button class="mp-cup" data-pick="venstre">Venstre krus</button>
            <button class="mp-cup" data-pick="midten">Midterste krus</button>
            <button class="mp-cup" data-pick="hoyre">Høyre krus</button>
          </div>
          <button class="curiosity curiosity--mouse" id="mp-mouse" aria-label="Ei lita mus med noe i munnen">🐁</button>
          <p class="game-msg" id="mp-msg" aria-live="polite"></p>

          <div class="hintbox">
            <button class="btn-quiet" id="mp-hint-btn">Direktørens hvisken (hint) 🤫</button>
            <ul class="hint-list" id="mp-hints"></ul>
          </div>
        </div>

        <div class="panel panel--solved" id="mp-solved" hidden>
          <p class="solved-title">✨ Gåten er løst</p>
          <div class="principle" id="mp-solution"></div>
          <div class="facts" id="mp-facts"></div>
          <button class="btn-gold" id="mp-complete">Fullfør rommet →</button>
        </div>
      </section>

      <!-- ── SCENE: EPILOG ───────────────────────────────────────── -->
      <section class="scene" id="sc-epilog" hidden aria-labelledby="ep-heading">
        <p class="scene-label">Akt I er fullført</p>
        <h2 class="scene-heading" id="ep-heading">{nb('epilog').title}</h2>
        <div class="scene-intro" set:html={nb('epilog').introHtml} />

        <div class="panel">
          <p class="game-msg" id="ep-deck-summary" aria-live="polite"></p>
          <p class="game-msg">«…Og skulle du savne magien i dagslys: Kabinettet finnes på dagtid også. Da heter det <strong>Tryllemuseet</strong>, og det står på Årvoll gård.»</p>
          <div class="btn-row">
            <button class="btn-gold" id="ep-act2">Løft forhenget — Akt II venter →</button>
            <button class="btn-gold" id="ep-poster">Last ned plakaten din 🖼️</button>
            <a class="btn-gold" href="/besok">Besøk museet i dagslys →</a>
            <button class="btn-quiet" id="ep-deck">Se kortstokken 🃏</button>
          </div>
        </div>
      </section>

      <!-- ═══ AKT II ═══════════════════════════════════════════════ -->

      <!-- ── SCENE: GALLERIET (SPEILGANGEN) ──────────────────────── -->
      <section class="scene" id="sc-galleriet" hidden aria-labelledby="ga-heading">
        <p class="scene-label">Mellomrommet · Ruter tre</p>
        <h2 class="scene-heading" id="ga-heading">{nb('galleriet').title}</h2>
        <div class="scene-intro" set:html={nb('galleriet').introHtml} />

        <div class="panel">
          <p class="game-msg" id="ga-msg" aria-live="polite">Seks malerier henger på veggen. Se nøye på hvert av dem — så nøye du klarer.</p>
          <div class="gallery" id="ga-wall"></div>
          <div class="btn-row">
            <button class="btn-gold" id="ga-blink-btn">Jeg har sett nok — blunk 👁️</button>
            <button class="btn-quiet" id="ga-giveup" hidden>Gi meg svaret 🎭</button>
          </div>
          <div class="reveal" id="ga-reveal" hidden>
            <div class="reveal-text" id="ga-solution"></div>
            <div class="facts" id="ga-facts"></div>
          </div>
          <button class="btn-gold" id="ga-continue" hidden>Videre til Biblioteket →</button>
          <div class="gallery-blink" id="ga-blink" hidden aria-hidden="true"><p>… blunk …</p></div>
        </div>
      </section>

      <!-- ── SCENE: BIBLIOTEKET ──────────────────────────────────── -->
      <section class="scene" id="sc-biblioteket" hidden aria-labelledby="bl-heading">
        <p class="scene-label">Fjerde rom · Firerne</p>
        <h2 class="scene-heading" id="bl-heading">{nb('biblioteket').title}</h2>
        <div class="scene-intro" set:html={nb('biblioteket').introHtml} />

        <div class="panel" id="bl-pathchoice">
          <p class="field-label">Velg din vei gjennom rommet</p>
          <div class="path-row">
            <button class="path-btn" data-scene="bl" data-path="laerling">
              <strong>Lærlingens vei</strong>
              <span>Bokens forklaringer står med rene ord</span>
            </button>
            <button class="path-btn" data-scene="bl" data-path="mester">
              <strong>Mesterens vei</strong>
              <span>Boken snakker i gåter — løser du alt uten hint, gylles sparkortet ditt</span>
            </button>
          </div>
        </div>

        <div class="panel" id="bl-game" hidden>
          <p class="game-msg">Fire tresnitt er revet løs fra boken, og fire forklaringer står igjen på siden. <strong>Sett hvert tresnitt sammen med hemmeligheten det avslører:</strong> trykk på et tresnitt, så på en forklaring.</p>
          <div class="match-grid">
            <div class="match-col" id="bl-woodcuts" aria-label="Tresnittene"></div>
            <div class="match-col" id="bl-secrets" aria-label="Forklaringene"></div>
          </div>
          <button class="curiosity" id="bl-worm" aria-label="En liten bokorm titter frem mellom to bind">🐛</button>
          <p class="game-msg" id="bl-msg" aria-live="polite"></p>

          <div class="hintbox">
            <button class="btn-quiet" id="bl-hint-btn">Direktørens hvisken (hint) 🤫</button>
            <ul class="hint-list" id="bl-hints"></ul>
          </div>
        </div>

        <div class="panel panel--solved" id="bl-solved" hidden>
          <p class="solved-title">✨ Gåten er løst</p>
          <div class="principle" id="bl-solution"></div>
          <div class="facts" id="bl-facts"></div>
          <button class="btn-gold" id="bl-complete">Fullfør rommet →</button>
        </div>
      </section>

      <!-- ── SCENE: ØYET SOM LYVER (SPEILGANGEN) ─────────────────── -->
      <section class="scene" id="sc-oyet" hidden aria-labelledby="oy-heading">
        <p class="scene-label">Mellomrommet · Ruter fire</p>
