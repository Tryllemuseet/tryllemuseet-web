    // ═══ DET FRIE VALGET (SPEILGANGEN: EQUIVOQUE) ════════════════
    const FV_ITEMS = lang === 'en' ? [
      { key: 'lykt',   icon: '🏮', name: 'The lantern' },
      { key: 'speil',  icon: '🪞', name: 'The mirror' },
      { key: 'kort',   icon: '🃏', name: 'The deck of cards' },
    ] : [
      { key: 'lykt',   icon: '🏮', name: 'Lykten' },
      { key: 'speil',  icon: '🪞', name: 'Speilet' },
      { key: 'kort',   icon: '🃏', name: 'Kortstokken' },
    ]
    // The prediction and the lines that name it come from the server when
    // the room is first played (roomStart).
    let fvPhase: 'pickTwo' | 'pickOne' | 'done' = 'pickTwo'
    let fvBusy = false
    let fvPicked: string[] = []
    let fvRemaining = FV_ITEMS.map(i => i.key)
    let fvReceipts: string[] = []

    function fvName(key: string) { return FV_ITEMS.find(i => i.key === key)!.name }

    function fvRender() {
      const box = $('fv-items')
      box.innerHTML = ''
      for (const item of FV_ITEMS) {
        if (!fvRemaining.includes(item.key)) continue
        const btn = document.createElement('button')
        btn.className = 'fv-item' + (fvPicked.includes(item.key) ? ' fv-item--picked' : '')
        btn.innerHTML = `<span class="fv-icon" aria-hidden="true">${item.icon}</span><span>${item.name}</span>`
        btn.disabled = fvPhase === 'done'
        btn.addEventListener('click', () => fvPick(item.key))
        box.appendChild(btn)
      }
    }

    function fvLogLine(text: string) {
      const li = document.createElement('li')
      li.textContent = text
      $('fv-log').appendChild(li)
    }

    async function fvPick(key: string) {
      if (fvBusy || fvPhase === 'done') return
      fvBusy = true
      const d = await roomStart('frievalget')
      fvBusy = false
      if (!d?.answer) return
      const target = d.answer
      const L = d.lines
      if (fvPhase === 'pickTwo') {
        if (fvPicked.includes(key)) {
          fvPicked = fvPicked.filter(k => k !== key)
          fvRender()
          return
        }
        fvPicked.push(key)
        fvRender()
        if (fvPicked.length < 2) return
        const keepPair = fvPicked.includes(target)
        const other = FV_ITEMS.map(i => i.key).find(k => !fvPicked.includes(k))!
        if (keepPair) {
          fvLogLine(lang === 'en'
            ? `You pointed at ${fvName(fvPicked[0]).toLowerCase()} and ${fvName(fvPicked[1]).toLowerCase()}. “Those two we keep,” says the Director — and clears away ${fvName(other).toLowerCase()}.`
            : `Du pekte på ${fvName(fvPicked[0]).toLowerCase()} og ${fvName(fvPicked[1]).toLowerCase()}. «De to beholder vi,» sier Direktøren — og rydder bort ${fvName(other).toLowerCase()}.`)
          fvReceipts.push(L['receipt:pairKeep'] ?? '')
          fvRemaining = [...fvPicked]
        } else {
          fvLogLine(lang === 'en'
            ? `You pointed at ${fvName(fvPicked[0]).toLowerCase()} and ${fvName(fvPicked[1]).toLowerCase()}. “Those two we clear away,” says the Director.`
            : `Du pekte på ${fvName(fvPicked[0]).toLowerCase()} og ${fvName(fvPicked[1]).toLowerCase()}. «De to rydder vi bort,» sier Direktøren.`)
          fvReceipts.push(L['receipt:pairClear'] ?? '')
          fvRemaining = [other]
        }
        fvPicked = []
        await sleep(300)
        if (fvRemaining.length === 2) {
          fvPhase = 'pickOne'
          $('fv-msg').innerHTML = t(
            'To gjenstander igjen. <strong>Pek på én av dem</strong> — fortsatt helt fritt.',
            'Two objects left. <strong>Point at one of them</strong> — still entirely freely.',
          )
        } else {
          fvFinish(L)
        }
        fvRender()
      } else if (fvPhase === 'pickOne') {
        if (key === target) {
          fvLogLine(lang === 'en'
            ? `You pointed at ${fvName(key).toLowerCase()}. “That one you keep,” says the Director — and clears away the last one.`
            : `Du pekte på ${fvName(key).toLowerCase()}. «Det beholder du,» sier Direktøren — og rydder bort det siste.`)
          fvReceipts.push(L['receipt:oneKeep'] ?? '')
        } else {
          fvLogLine(lang === 'en'
            ? `You pointed at ${fvName(key).toLowerCase()}. “That one we clear away,” says the Director.`
            : `Du pekte på ${fvName(key).toLowerCase()}. «Det rydder vi bort,» sier Direktøren.`)
          fvReceipts.push(L['receipt:oneClear'] ?? '')
        }
        fvRemaining = [target]
        fvFinish(L)
        fvRender()
      }
    }

    function fvFinish(L: Record<string, string>) {
      fvPhase = 'done'
      $('fv-msg').textContent = L['remaining'] ?? ''
      const envelope = document.createElement('em')
      envelope.textContent = L['envelope'] ?? ''
      $('fv-envelope').replaceChildren('✉️ ', envelope)
      $('fv-verdict').textContent = L['verdict'] ?? ''
      awardCard(5, 'ruter', t('Illusjonskortet fra Det frie valget', 'The illusion card of the Free Choice'))
      $('fv-result').hidden = false
    }

    $('fv-reveal-btn').addEventListener('click', async () => {
      const btn = $('fv-reveal-btn') as HTMLButtonElement
      btn.disabled = true
      const r = await check('frievalget')
      btn.disabled = false
      if (!r) return
      const list = $('fv-receipts')
      list.innerHTML = ''
      for (const r of fvReceipts) {
        const li = document.createElement('li')
        li.textContent = r
        list.appendChild(li)
      }
      showSolution('fv', r.solved)
      $('fv-reveal').hidden = false
    })
    $('fv-continue').addEventListener('click', () => goTo('teateret'))

    // ═══ TEATERET ════════════════════════════════════════════════
    // Which actions get you out, and in which order, is known only to the server.
    interface TeAction { key: string; label: string }
    const TE_ACTIONS: TeAction[] = lang === 'en' ? [
      { key: 'lokk',   label: 'Push the lid with all your strength' },
      { key: 'rop',    label: 'Shout for help' },
      { key: 'som',    label: 'Feel along the seam in the trunk’s short side' },
      { key: 'knott',  label: 'Turn the catch half a turn' },
      { key: 'panel',  label: 'Slide the panel aside and slip out' },
      { key: 'morse',  label: 'Knock SOS on the bottom board' },
    ] : [
      { key: 'lokk',   label: 'Dytt lokket med all kraft' },
      { key: 'rop',    label: 'Rop om hjelp' },
      { key: 'som',    label: 'Kjenn langs sømmen i kistens kortside' },
      { key: 'knott',  label: 'Vri knotten en halv omdreining' },
      { key: 'panel',  label: 'Skyv panelet til side og smyg deg ut' },
      { key: 'morse',  label: 'Bank SOS i bunnplaten' },
    ]
    let tePath = state.path['teateret'] || ''
    let teHintsUsed = 0
    let teWrong = 0
    let teSteps: string[] = []   // the actions that worked, in order
    let teDone = false
    let teBusy = false

    wireHints('te-hint-btn', 'te-hints', 'teateret', () => { teHintsUsed++ })

    function teRender() {
      const box = $('te-actions')
      box.innerHTML = ''
      for (const a of TE_ACTIONS) {
        const btn = document.createElement('button')
        btn.className = 'mp-cup'
        btn.textContent = a.label
        btn.disabled = teDone || teSteps.includes(a.key)
        btn.addEventListener('click', () => teAct(a))
        box.appendChild(btn)
      }
    }

    async function teAct(a: TeAction) {
      if (teDone || teBusy) return
      teBusy = true
      const r = await check('teateret', { steps: teSteps, value: a.key })
      teBusy = false
      if (!r) return
      const li = document.createElement('li')
      li.textContent = r.msg ?? ''
      $('te-log').appendChild(li)
      if (r.ok) {
        teSteps.push(a.key)
        $('te-msg').textContent = ''
        if (r.solved) {
          teDone = true
          solveRoom('te', 7, t('Sigillet fra Teateret', 'The seal of the Theatre'),
            tePath === 'mester' && teHintsUsed === 0 && teWrong === 0, r.solved)
        }
      } else {
        teWrong++
        // A right action at the wrong time only gets the log line.
        if (!r.early) $('te-msg').textContent = t('Publikum teller videre. Prøv noe annet.', 'The audience keep counting. Try something else.')
      }
      teRender()
    }

    document.querySelectorAll<HTMLButtonElement>('.path-btn[data-scene="te"]').forEach(btn =>
      btn.addEventListener('click', () => {
        tePath = btn.dataset.path || 'laerling'
        state.path['teateret'] = tePath
        save()
        $('te-pathchoice').hidden = true
        $('te-game').hidden = false
        roomLine('teateret', tePath).then(line => { $('te-pretext').textContent = line })
        teRender()
      })
    )

    $('te-ticket').addEventListener('click', () => {
      $('te-ticket').hidden = true
      awardCard(7, 'klover', t('Kuriositeten: teaterbilletten i kistens fôr', 'The curiosity: the theatre ticket in the trunk’s lining'))
    })

    $('te-complete').addEventListener('click', () => {
      awardCard(7, 'hjerter', t('Plakatkortet fra Teateret er trykket', 'The Theatre poster card is printed'))
      goTo('kinoen')
    })

    // ═══ KINOEN ══════════════════════════════════════════════════
    // The strips as they lie on the floor; the right order is known only to
    // the server. kiOrder holds the strips placed so far (indexes into
    // KI_STRIPS), in film order.
    const KI_STRIPS = lang === 'en' ? [
      'The cloth is whipped away — the chair is empty',
      'The lady is back, and bows to the house',
      'The lady takes her seat in the chair',
      'The magician conjures — a skeleton sits in the chair!',
      'The cloth is spread over her',
    ] : [
      'Kledet rives bort — stolen er tom',
      'Damen er tilbake, og bukker mot salen',
      'Damen tar plass i stolen',
      'Magikeren maner — et skjelett sitter i stolen!',
      'Kledet bres over henne',
    ]
    let kiPath = state.path['kinoen'] || ''
    let kiHintsUsed = 0
    let kiWrong = 0
    let kiOrder: number[] = []
    let kiPhase = 1
    let kiBusy = false

    wireHints('ki-hint-btn', 'ki-hints', 'kinoen', () => { kiHintsUsed++ })

    function kiRenderStrips() {
      const box = $('ki-strips')
      box.innerHTML = ''
      KI_STRIPS.forEach((text, idx) => {
        const placed = kiOrder.indexOf(idx)
        const btn = document.createElement('button')
        btn.className = 'ki-strip'
        btn.innerHTML = `<span class="ki-frame" aria-hidden="true">🎞️</span><span>${text}</span><span class="ki-order">${placed >= 0 ? placed + 1 : ''}</span>`
        btn.disabled = placed >= 0
        if (placed >= 0) btn.classList.add('ki-strip--placed')
        btn.addEventListener('click', async () => {
          if (kiBusy) return
          kiBusy = true
          const r = await check('kinoen', { part: 'order', steps: kiOrder.map(String), value: String(idx) })
          kiBusy = false
          if (!r) return
          if (r.ok) {
            kiOrder.push(idx)
            const complete = kiOrder.length === KI_STRIPS.length
            $('ki-msg').textContent = complete ? '' : (r.msg ?? '')
            kiRenderStrips()
            if (complete) kiStartPhase2()
          } else {
            kiWrong++
            $('ki-msg').textContent = r.msg ?? ''
          }
        })
        box.appendChild(btn)
      })
    }

    function kiStartPhase2() {
      kiPhase = 2
      $('ki-phase1').hidden = true
      const gaps = $('ki-gaps')
      gaps.innerHTML = ''
      for (let i = 0; i < KI_STRIPS.length - 1; i++) {
        const btn = document.createElement('button')
        btn.className = 'mp-cup'
        btn.textContent = t(`Mellom ${i + 1} og ${i + 2}`, `Between ${i + 1} and ${i + 2}`)
        btn.addEventListener('click', async () => {
          const gapBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#ki-gaps .mp-cup'))
          gapBtns.forEach(b => { b.disabled = true })
          const r = await check('kinoen', { part: 'cut', steps: kiOrder.map(String), value: String(i) })
          if (!r) { gapBtns.forEach(b => { b.disabled = false }); return }
          $('ki-msg').textContent = r.msg ?? ''
          if (r.ok) {
            solveRoom('ki', 8, t('Sigillet fra Kinoen', 'The seal of the Cinema'),
              kiPath === 'mester' && kiHintsUsed === 0 && kiWrong === 0, r.solved)
          } else {
            kiWrong++
            gapBtns.forEach(b => { b.disabled = false })
          }
        })
        gaps.appendChild(btn)
      }
      $('ki-phase2').hidden = false
    }

    document.querySelectorAll<HTMLButtonElement>('.path-btn[data-scene="ki"]').forEach(btn =>
      btn.addEventListener('click', () => {
        kiPath = btn.dataset.path || 'laerling'
        state.path['kinoen'] = kiPath
        save()
        $('ki-pathchoice').hidden = true
        $('ki-game').hidden = false
        roomLine('kinoen', kiPath).then(line => { $('ki-pretext').textContent = line })
        kiRenderStrips()
      })
    )

    $('ki-clip').addEventListener('click', () => {
      $('ki-clip').hidden = true
      awardCard(8, 'klover', t('Kuriositeten: filmbiten fra klipperommet', 'The curiosity: the film scrap from the cutting room'))
    })

    $('ki-complete').addEventListener('click', () => {
      awardCard(8, 'hjerter', t('Plakatkortet fra Kinoen er trykket', 'The Cinema poster card is printed'))
      goTo('lerretet')
    })

    // ═══ ÅNDEN PÅ LERRETET (SPEILGANGEN: ETTERBILDE) ═════════════
    // NB: the stare needs real seconds regardless of prefers-reduced-motion —
    // this is exposure time for the eyes, not animation.
    const LE_STARE_MS = 12000
    let leLit = false

    function leSetFigure(on: boolean) {
      ;(document.getElementById('le-figure') as unknown as SVGGElement).style.display = on ? '' : 'none'
      ;(document.getElementById('le-blank-text') as unknown as SVGTextElement).style.display = on ? 'none' : ''
    }

    $('le-light').addEventListener('click', () => {
      if (leLit) return
      leLit = true
      ;($('le-light') as HTMLButtonElement).disabled = true
      leSetFigure(true)
      let left = LE_STARE_MS / 1000
      const stareLine = (s: number) => t(`Stirr på den hvite prikken … ${s}`, `Stare at the white dot … ${s}`)
      $('le-msg').textContent = stareLine(left)
      const timer = window.setInterval(() => {
        left--
        if (left > 0) {
          $('le-msg').textContent = stareLine(left)
        } else {
          window.clearInterval(timer)
          leSetFigure(false)
          leLit = false
          ;($('le-light') as HTMLButtonElement).disabled = false
          ;($('le-light') as HTMLButtonElement).textContent = t('Tenn lampen igjen 🕯️', 'Light the lamp again 🕯️')
          $('le-msg').textContent = t('Lampen slukker. Se på det tomme lerretet — hva ser du?', 'The lamp goes out. Look at the empty canvas — what do you see?')
          $('le-after').hidden = false
        }
      }, 1000)
    })

    async function leFinish(sawIt: boolean) {
      $('le-after').hidden = true
      $('le-controls').hidden = true
      $('le-msg').textContent = sawIt
        ? t(
            'Direktøren smiler i mørket. «Der. Kabinettets billigste spøkelse — og det bor i deg.»',
            'The Director smiles in the dark. “There. The Cabinet’s cheapest ghost — and it lives in you.”',
          )
        : t(
            'Direktøren nikker. «Noen øyne er mer lettlurte enn andre. Her er det du ville sett:»',
            'The Director nods. “Some eyes are more easily fooled than others. Here is what you would have seen:”',
          )
      awardCard(6, 'ruter', t('Illusjonskortet fra Ånden på lerretet', 'The illusion card of the Ghost on the Canvas'))
      ;($('le-continue') as HTMLButtonElement).hidden = false
      const r = await check('lerretet')
      showSolution('le', r?.solved)
      $('le-reveal').hidden = !r
    }

    $('le-saw').addEventListener('click', () => leFinish(true))
    let leNothingCount = 0
    $('le-nothing').addEventListener('click', () => {
      leNothingCount++
      if (leNothingCount < 2) {
        $('le-after').hidden = true
        $('le-msg').textContent = t(
          'Direktøren: «Tenn lampen igjen — og hold blikket helt, helt stille på prikken.»',
          'The Director: “Light the lamp again — and keep your gaze completely, completely still on the dot.”',
        )
      } else {
        leFinish(false)
      }
    })
    $('le-skip').addEventListener('click', () => leFinish(false))
    $('le-continue').addEventListener('click', () => goTo('verkstedet'))

    // ═══ VERKSTEDET ══════════════════════════════════════════════
    // Which three parts belong in the illusion is known only to the server.
    interface VsPart { laerling: string; mester: string }
    const VS_PARTS: VsPart[] = lang === 'en' ? [
      { laerling: 'An S-shaped steel arm (a “gooseneck”) from a column behind the stage curtain',
        mester: 'Steel that curves where no one looks' },
      { laerling: 'Thin threads from the fly loft',
        mester: 'What hangs, hangs from something' },
      { laerling: 'A heavy counterweight hidden beneath the stage floor',
        mester: 'What floats rests on what lies' },
      { laerling: 'A powerful magnet under the stage',
        mester: 'An iron will beneath the floorboards' },
      { laerling: 'A drape in the same colour as the backdrop, concealing the arm',
        mester: 'Velvet against velvet: nothing to see' },
      { laerling: 'An angled mirror in front of the lady',
        mester: 'The house sees what the house should see' },
    ] : [
      { laerling: 'En s-formet stålarm («svanehals») fra en søyle bak sceneteppet',
        mester: 'Stål som svinger seg dit ingen ser' },
      { laerling: 'Tynne tråder fra snorloftet',
        mester: 'Det som henger, henger i noe' },
      { laerling: 'En tung motvekt skjult under scenegulvet',
        mester: 'Det som svever, hviler på det som ligger' },
      { laerling: 'En kraftig magnet under scenen',
        mester: 'Jernvilje under gulvplankene' },
      { laerling: 'Et draperi i samme farge som bakteppet, som skjuler armen',
        mester: 'Fløyel mot fløyel: intet å se' },
      { laerling: 'Et vinklet speil foran damen',
        mester: 'Salen ser det salen bør se' },
    ]
    let vsPath = state.path['verkstedet'] || ''
    let vsHintsUsed = 0
    let vsWrong = 0
    let vsSolved = false
    let vsBusy = false

    wireHints('vs-hint-btn', 'vs-hints', 'verkstedet', () => { vsHintsUsed++ })

    function vsRender() {
      const list = $('vs-parts')
      list.innerHTML = ''
      VS_PARTS.forEach((p, i) => {
        const li = document.createElement('li')
        const label = document.createElement('label')
        const box = document.createElement('input')
        box.type = 'checkbox'
        box.value = String(i)
        label.appendChild(box)
        label.appendChild(document.createTextNode(' ' + (vsPath === 'mester' ? p.mester : p.laerling)))
        li.appendChild(label)
        list.appendChild(li)
      })
    }

    document.querySelectorAll<HTMLButtonElement>('.path-btn[data-scene="vs"]').forEach(btn =>
      btn.addEventListener('click', () => {
        vsPath = btn.dataset.path || 'laerling'
        state.path['verkstedet'] = vsPath
        save()
        $('vs-pathchoice').hidden = true
        $('vs-game').hidden = false
        vsRender()
      })
    )

    $('vs-submit').addEventListener('click', async () => {
      if (vsSolved || vsBusy) return
      const checked = Array.from(document.querySelectorAll<HTMLInputElement>('#vs-parts input:checked')).map(b => b.value)
      vsBusy = true
      const r = await check('verkstedet', { values: checked, path: vsPath })
      vsBusy = false
      if (!r) return
      $('vs-msg').textContent = r.msg ?? ''
      if (r.ok) {
        vsSolved = true
        document.querySelectorAll<HTMLInputElement>('#vs-parts input').forEach(b => { b.disabled = true })
        ;($('vs-submit') as HTMLButtonElement).disabled = true
        solveRoom('vs', 9, t('Sigillet fra Verkstedet', 'The seal of the Workshop'),
          vsPath === 'mester' && vsHintsUsed === 0 && vsWrong === 0, r.solved)
      } else if (!r.invalid) {
        vsWrong++
      }
    })

    $('vs-screw').addEventListener('click', () => {
      $('vs-screw').hidden = true
      awardCard(9, 'klover', t('Kuriositeten: messingskruen fra Sfinks-bordet', 'The curiosity: the brass screw from the Sphinx table'))
    })

    $('vs-complete').addEventListener('click', () => {
      awardCard(9, 'hjerter', t('Plakatkortet fra Verkstedet er trykket', 'The Workshop poster card is printed'))
      goTo('epilog3')
    })

    // ═══ EPILOG AKT III ══════════════════════════════════════════
    function renderEpilog3() {
      const n = state.cards.filter(c => parseInt(c) <= 9).length
      let txt = lang === 'en'
        ? `After three nights in the Cabinet you have ${n} of ${TOTAL_ACT3} cards in your deck`
        : `Etter tre netter i Kabinettet har du ${n} av ${TOTAL_ACT3} kort i kortstokken`
      txt += gildedPhrase(state.gilded.length)
      txt += n >= TOTAL_ACT3 - 3
        ? t(
            'Direktøren stryker over kortene: «Tre netter — og en nesten full stokk. Det trettende rommet har begynt å lytte.»',
            'The Director runs a hand over the cards: “Three nights — and a nearly full deck. The thirteenth room has begun to listen.”',
          )
        : REMEMBER_LINE
      $('ep3-deck-summary').textContent = txt
    }
    $('ep3-poster').addEventListener('click', downloadPoster)
    $('ep3-deck').addEventListener('click', () => { renderDeck(); deckModal.showModal() })
    $('ep3-act4').addEventListener('click', () => goTo('minnet'))

    // ═══ MINNET SOM DIKTER (SPEILGANGEN: FALSKE MINNER) ══════════
    // DRM-style word list: every word points at the lure («søvn»/"sleep")
    // without the lure itself ever appearing. Each language needs its own
    // psychologically coherent list — this is not a translation.
    const MN_WORDS = lang === 'en'
      ? ['bed', 'pillow', 'night', 'dream', 'wake', 'tired', 'blanket', 'yawn', 'rest', 'darkness', 'snore', 'evening']
      : ['seng', 'pute', 'natt', 'drøm', 'våkne', 'trøtt', 'dyne', 'gjespe', 'hvile', 'mørke', 'snorke', 'kveld']
    // The three questions; the server judges the answers.
    const MN_PROBES = lang === 'en' ? ['pillow', 'sleep', 'lamp'] : ['pute', 'søvn', 'lampe']
    let mnProbe = 0
    let mnAnswers: string[] = []

    function mnRenderWords(containerId: string) {
      const box = $(containerId)
      box.innerHTML = ''
      for (const w of MN_WORDS) {
        const span = document.createElement('span')
        span.className = 'mn-word'
        span.textContent = w
        box.appendChild(span)
      }
    }

    function mnAsk() {
      const word = MN_PROBES[mnProbe]
      $('mn-q').innerHTML = lang === 'en'
        ? `Was the word <strong>“${word}”</strong> on the mirror?`
        : `Sto ordet <strong>«${word}»</strong> på speilet?`
    }

    let mnBusy = false
    async function mnAnswer(saidYes: boolean) {
      if (mnBusy || mnProbe >= MN_PROBES.length) return
      mnAnswers[mnProbe] = saidYes ? 'yes' : 'no'
      if (mnProbe + 1 < MN_PROBES.length) {
        mnProbe++
        mnAsk()
        return
      }
      mnBusy = true
      const r = await check('minnet', { values: mnAnswers })
      mnBusy = false
      if (!r) return
      mnProbe++
      $('mn-quiz').hidden = true
      $('mn-verdict').textContent = r.msg ?? ''
      mnRenderWords('mn-words-again')
      showSolution('mn', r.solved)
      awardCard(7, 'ruter', t('Illusjonskortet fra Minnet som dikter', 'The illusion card of the Memory That Invents'))
      $('mn-result').hidden = false
    }

    $('mn-start').addEventListener('click', () => {
      $('mn-intro').hidden = true
      mnRenderWords('mn-words')
      $('mn-study').hidden = false
    })
    $('mn-done').addEventListener('click', () => {
      $('mn-study').hidden = true
      mnAsk()
      $('mn-quiz').hidden = false
    })
    $('mn-yes').addEventListener('click', () => mnAnswer(true))
    $('mn-no').addEventListener('click', () => mnAnswer(false))
    $('mn-continue').addEventListener('click', () => goTo('studioet'))

    // ═══ STUDIOET ════════════════════════════════════════════════
    // The ×9 force works in both languages, but the punchline differs:
    // Danmark ends in K → «katt» in Norwegian, Denmark ends in K →
    // "kitten" in English.
    const ST_STEPS = lang === 'en' ? [
      'The host: “Pick a whole number from 1 to 9. Keep it secret — even from camera two.”',
      '“Multiply your number by 9.”',
      '“Does the answer have two digits? Add them together, so you are left with a single digit.”',
      '“Subtract 5.”',
      '“Turn the number into a letter: 1 is A, 2 is B, 3 is C, 4 is D — and so on.”',
      '“Think of a country in Europe that begins with your letter.”',
      '“And finally: think of a pet that begins with the last letter of the country.”',
    ] : [
      'Programlederen: «Velg et helt tall fra 1 til 9. Hold det hemmelig — også for kamera to.»',
      '«Gang tallet ditt med 9.»',
      '«Har svaret to sifre? Legg dem sammen, så du står igjen med ett siffer.»',
      '«Trekk fra 5.»',
      '«Gjør tallet om til en bokstav: 1 er A, 2 er B, 3 er C, 4 er D — og så videre.»',
      '«Tenk på et land i Europa som begynner på bokstaven din.»',
      '«Og til slutt: tenk på et husdyr som begynner på landets siste bokstav.»',
    ]
    let stStep = 0
    let stPath = state.path['studioet'] || ''
    let stHintsUsed = 0
    let stWrong = 0

    wireHints('st-hint-btn', 'st-hints', 'studioet', () => { stHintsUsed++ })

    $('st-next').addEventListener('click', () => {
      stStep++
      if (stStep < ST_STEPS.length) {
        $('st-step').textContent = ST_STEPS[stStep]
      } else {
        $('st-trick').hidden = true
        $('st-claim').hidden = false
      }
    })

    function stToDeduce() {
      $('st-claim').hidden = true
      $('st-deduce').hidden = false
    }
    $('st-hit').addEventListener('click', stToDeduce)
    $('st-miss').addEventListener('click', () => {
      const msg = $('st-claim-msg')
      msg.textContent = t(
        'Programlederen blunker uanfektet: «Da er du blant de få, seer. Men de fleste der hjemme sitter med en katt i Danmark akkurat nå.»',
        'The host winks, unfazed: “Then you are among the few, dear viewer. But most people at home are sitting with a kitten in Denmark right now.”',
      )
      msg.hidden = false
      window.setTimeout(stToDeduce, reducedMotion ? 400 : 1800)
    })

    const stOptions = Array.from(document.querySelectorAll<HTMLButtonElement>('#st-options .mp-cup'))
    stOptions.forEach(btn =>
      btn.addEventListener('click', async () => {
        stOptions.forEach(b => { b.disabled = true })
        const r = await check('studioet', { value: btn.dataset.st })
        if (!r) { stOptions.forEach(b => { b.disabled = false }); return }
        $('st-msg').textContent = r.msg ?? ''
