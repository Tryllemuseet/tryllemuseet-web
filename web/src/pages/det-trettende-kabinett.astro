      btn.addEventListener('click', async () => {
        vhPath = btn.dataset.path || 'laerling'
        state.path['vinterhagen'] = vhPath
        save()
        $('vh-pathchoice').hidden = true
        $('vh-game').hidden = false
        vhRender()
        if (vhPath === 'laerling') {
