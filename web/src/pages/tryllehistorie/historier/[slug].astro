---
// src/pages/tryllehistorie/historier/[slug].astro
import BaseLayout from '../../../layouts/BaseLayout.astro'
import MentionedMagicians from '../../../components/MentionedMagicians.astro'
import { getStoryBySlug, getStoryPaths, portableTextToHtml } from '../../../lib/sanity'
import type { Story } from '../../../lib/sanity'

export async function getStaticPaths() {
  const paths = await getStoryPaths()
  return paths
}

const { slug } = Astro.params
const s = await getStoryBySlug(slug!) as Story | null

if (!s) return Astro.redirect('/tryllehistorie/historier')

const contentHtml = portableTextToHtml(s.body)
const publishedDate = new Date(s.publishedAt).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })
---

<BaseLayout
  title={`${s.title} — Små historier fra tryllekunsten — Tryllemuseet`}
  description={s.teaser}
>

  <!-- HERO ──────────────────────────────────────────────────────── -->
  <section class="story-hero">
    <div class="story-hero-bg">
      {s.image?.asset?.url && (
        <img src={s.image.asset.url} alt="" aria-hidden="true" class="hero-bg-img" />
      )}
      <div class="hero-bg-overlay"></div>
    </div>
    <div class="container story-hero-inner">
      <nav class="breadcrumb">
        <a href="/tryllehistorie">Tryllehistorie</a>
        <span>›</span>
        <a href="/tryllehistorie/historier">Små historier</a>
      </nav>
      <p class="story-hero-date">{publishedDate}</p>
      <h1 class="story-hero-title">{s.title}</h1>
      <p class="story-hero-teaser">{s.teaser}</p>
    </div>
  </section>

  <div class="container article-layout">

    <!-- HISTORIEN ──────────────────────────────────────────────── -->
    <main class="article-main">

      <div class="prose" set:html={contentHtml} />

      {s.sourceNote && (
        <p class="kildenote">Kildenote: {s.sourceNote}</p>
      )}

      <MentionedMagicians magicians={s.mentionedMagicians} />

    </main>

    <!-- SIDEBAR ────────────────────────────────────────────────── -->
    <aside class="article-sidebar">

      {s.image?.asset?.url && (
        <figure class="sidebar-bilde">
          <img src={s.image.asset.url} alt={s.image.alt ?? s.title} />
          {s.image.caption && <figcaption>{s.image.caption}</figcaption>}
        </figure>
      )}

      {s.sources && s.sources.length > 0 && (
        <div class="kilder-boks">
          <h3 class="faktaboks-heading">Kilder</h3>
          <ul class="kilder-liste">
            {s.sources.map((k) => (
              <li>
                {k.url
                  ? <a href={k.url} target="_blank" rel="noopener noreferrer">{k.label}</a>
                  : <span>{k.label}</span>
                }
              </li>
            ))}
          </ul>
        </div>
      )}

    </aside>
  </div>

  <!-- NAVIGASJON ─────────────────────────────────────────────────── -->
  <div class="container page-nav">
    <a href="/tryllehistorie/historier">← Alle historiene</a>
    <a href="/tryllehistorie">← Tryllehistorie</a>
  </div>

</BaseLayout>

<style>
  /* ── Hero ── */
  .story-hero { position: relative; min-height: 300px; display: flex; align-items: flex-end; padding-bottom: 3rem; color: var(--cream); overflow: hidden; background: var(--burgundy-dk); }
  .story-hero-bg { position: absolute; inset: 0; }
  .hero-bg-img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .hero-bg-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,5,2,0.4) 0%, rgba(10,5,2,0.85) 100%); }
  .story-hero-inner { position: relative; z-index: 1; }
  .breadcrumb { display: flex; gap: 0.5rem; align-items: center; font-family: var(--font-ui); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1rem; }
  .breadcrumb a { color: var(--gold); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: rgba(251,247,239,0.4); }
  .story-hero-date { font-family: var(--font-ui); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold-light); margin-bottom: 0.6rem; }
  .story-hero-title { font-family: var(--font-display); font-size: clamp(1.8rem, 5vw, 3rem); color: var(--cream); line-height: 1.2; margin-bottom: 0.75rem; }
  .story-hero-teaser { font-family: var(--font-body); font-size: 1.05rem; opacity: 0.85; max-width: 620px; line-height: 1.6; }

  /* ── Layout ── */
  .article-layout { display: grid; grid-template-columns: 1fr 280px; gap: 3.5rem; align-items: start; padding-block: 3rem; }
  @media (max-width: 768px) { .article-layout { grid-template-columns: 1fr; } }

  /* ── Prose ── */
  .prose :global(p)          { font-family: var(--font-body); font-size: 1rem; color: #333; line-height: 1.8; margin-bottom: 1.1em; }
  .prose :global(p:first-of-type)::first-letter { font-family: var(--font-display); font-size: 3.2rem; float: left; line-height: 0.85; padding: 0.1em 0.12em 0 0; color: var(--burgundy); }
  .prose :global(h2)         { font-family: var(--font-display); font-size: 1.3rem; color: var(--burgundy); margin: 2rem 0 0.75rem; }
  .prose :global(h3)         { font-family: var(--font-display); font-size: 1.1rem; color: var(--burgundy); margin: 1.5rem 0 0.5rem; }
  .prose :global(strong)     { font-weight: 700; color: var(--ink); }
  .prose :global(em)         { font-style: italic; }
  .prose :global(a)          { color: var(--burgundy); text-decoration: underline; }
  .prose :global(a:hover)    { color: var(--gold-dark); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.5em; margin-bottom: 1em; }
  .prose :global(li)         { font-family: var(--font-body); font-size: 1rem; color: #333; line-height: 1.7; margin-bottom: 0.3em; }
  .prose :global(blockquote) { border-left: 3px solid var(--gold); padding-left: 1.25em; margin: 1.5em 0; font-style: italic; color: #555; }

  .kildenote { font-family: var(--font-ui); font-size: 0.8rem; color: var(--grey); line-height: 1.6; border-top: 1px solid var(--cream-dark); padding-top: 1rem; margin-top: 2rem; }

  /* ── Sidebar ── */
  .sidebar-bilde { margin-bottom: 1.5rem; border-radius: 6px; overflow: hidden; box-shadow: 0 4px 16px rgba(26,18,8,0.12); }
  .sidebar-bilde img { width: 100%; display: block; }
  .sidebar-bilde figcaption { font-family: var(--font-ui); font-size: 0.75rem; color: var(--grey); padding: 0.5rem 0.75rem; background: var(--cream); }

  .kilder-boks { background: var(--cream); border: 1px solid var(--cream-dark); padding: 1.25rem 1.5rem; border-radius: 2px; }
  .faktaboks-heading { font-family: var(--font-display); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--burgundy); margin-bottom: 1rem; }
  .kilder-liste { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .kilder-liste a { font-family: var(--font-ui); font-size: 0.8rem; color: var(--burgundy); text-decoration: underline; word-break: break-all; }
  .kilder-liste span { font-family: var(--font-ui); font-size: 0.8rem; color: var(--grey); }

  /* ── Navigasjon ── */
  .page-nav { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 1.5rem 0 3rem; font-family: var(--font-ui); font-size: 0.875rem; }
  .page-nav a { color: var(--grey); text-decoration: none; border: 1px solid var(--cream-dark); padding: 0.4rem 1rem; border-radius: var(--radius); transition: color 150ms, border-color 150ms; }
  .page-nav a:hover { color: var(--burgundy); border-color: var(--gold); }
</style>
