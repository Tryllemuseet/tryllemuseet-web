---
// src/pages/tryllehistorie/historier/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getStoryArchive } from '../../../lib/sanity'
import type { Story } from '../../../lib/sanity'

const stories = await getStoryArchive()
const total = stories.length

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })
---

<BaseLayout
  title="Små historier fra tryllekunsten — Tryllemuseet"
  description="Korte fortellinger fra magiens historie — én liten historie i uken, fra åndeskap og gullaldermagikere til norske kuriositeter."
>

  <!-- HERO ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <p class="section-label"><a href="/tryllehistorie" class="breadcrumb-link">Tryllehistorie</a></p>
      <h1 class="display-title hero-title">Små historier fra tryllekunsten</h1>
      <p class="hero-sub">
        Korte fortellinger fra magiens historie — som regel én ny i uken. Perfekte
        for en kaffepause: to minutter å lese, umulige å glemme.
      </p>
    </div>
  </section>

  <!-- KORTLISTE ──────────────────────────────────────────────────── -->
  <main class="container story-grid">
    {stories.map((s: Story, i: number) => (
      <article class="story-card">
        <a href={`/tryllehistorie/historier/${s.slug}`} class="story-link">
          <div class="story-img">
            {s.image?.asset?.url ? (
              <img src={s.image.asset.url} alt={s.image.alt ?? s.title} loading="lazy" />
            ) : (
              <div class="story-img-placeholder" aria-hidden="true">✨</div>
            )}
            {i === 0 && <span class="story-badge">Nyeste</span>}
          </div>
          <div class="story-body">
            <p class="story-date">{formatDate(s.publishedAt)}</p>
            <h2 class="story-title">{s.title}</h2>
            <p class="story-teaser">{s.teaser}</p>
            <span class="story-link-hint">Les historien →</span>
          </div>
        </a>
      </article>
    ))}
  </main>

  {total === 0 && (
    <div class="container empty-state">
      <p>Ingen historier er publisert ennå. Kom tilbake snart.</p>
    </div>
  )}

  <div class="container page-nav">
    <a href="/tryllehistorie/hvem-skulle-trodd">← Hvem skulle trodd?</a>
    <a href="/tryllehistorie">← Tryllehistorie</a>
  </div>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero { background: var(--burgundy-dk); padding: 3.5rem 0 2.5rem; border-bottom: 2px solid var(--gold-dark); color: var(--cream); }
  .breadcrumb-link { color: var(--gold); text-decoration: none; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
  .breadcrumb-link:hover { color: var(--gold-light); }
  .hero-title { font-size: clamp(1.8rem, 5vw, 3rem); color: var(--cream); margin: 0.5rem 0 0.75rem; }
  .hero-sub { font-family: var(--font-ui); font-size: 1rem; opacity: 0.8; max-width: 620px; line-height: 1.6; }

  /* ── Grid ── */
  .story-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; padding-block: 2.5rem 3rem; }

  /* ── Kort ── */
  .story-card { background: white; border: 1px solid var(--cream-dark); border-radius: 6px; overflow: hidden; transition: box-shadow 150ms, border-color 150ms; }
  .story-card:hover { box-shadow: 0 6px 24px rgba(107,15,26,0.12); border-color: var(--gold-light); }
  .story-link { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); height: 100%; }

  .story-img { position: relative; width: 100%; aspect-ratio: 16/9; overflow: hidden; background: var(--burgundy-dk); flex-shrink: 0; }
  .story-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms; }
  .story-card:hover .story-img img { transform: scale(1.03); }
  .story-img-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 3rem; background: linear-gradient(160deg, var(--burgundy-dk), #2a1208); }
  .story-badge { position: absolute; top: 0.6rem; left: 0.6rem; font-family: var(--font-ui); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.2rem 0.55rem; border-radius: 3px; background: var(--burgundy); color: var(--gold-light); }

  .story-body { padding: 1.1rem 1.25rem 1.3rem; flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }
  .story-date { font-family: var(--font-ui); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold-dark); }
  .story-title { font-family: var(--font-display); font-size: 1.1rem; color: var(--burgundy); line-height: 1.3; }
  .story-teaser { font-family: var(--font-ui); font-size: 0.875rem; color: var(--ink-mid); line-height: 1.55; flex: 1; }
  .story-link-hint { font-family: var(--font-ui); font-size: 0.8rem; font-weight: 700; color: var(--burgundy); margin-top: 0.4rem; }

  /* ── Tomt ── */
  .empty-state { padding: 4rem 0; text-align: center; font-family: var(--font-ui); color: var(--grey); }

  /* ── Navigasjon ── */
  .page-nav { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 1.5rem 0 3rem; font-family: var(--font-ui); font-size: 0.875rem; }
  .page-nav a { color: var(--grey); text-decoration: none; border: 1px solid var(--cream-dark); padding: 0.4rem 1rem; border-radius: var(--radius); transition: color 150ms, border-color 150ms; }
  .page-nav a:hover { color: var(--burgundy); border-color: var(--gold); }

  @media (max-width: 560px) {
    .story-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
