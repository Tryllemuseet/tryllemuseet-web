---
// src/pages/tryllehistorie/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import Button from '../../components/Button.astro'
import ContentCard from '../../components/ContentCard.astro'
import HubSubnavGrid from '../../components/HubSubnavGrid.astro'
import AutoContentGrid from '../../components/AutoContentGrid.astro'
import { getTryllehistoriePage, getUncoveredSubAreas, getWeeklyBiographyPick } from '../../lib/sanity'

const [page, weeklyBiography] = await Promise.all([
  getTryllehistoriePage(),
  getWeeklyBiographyPick(),
])

// Sikkerhetsnett: underområder av «Arkivet» som ikke allerede har et
// håndkurert kort i page.seksjoner over — se HubSubnavGrid.astro.
const coveredHrefs = page.seksjoner.map(s => s.href)
const uncoveredSubAreas = await getUncoveredSubAreas('/tryllehistorie', coveredHrefs)

const weeklyBiographyItem = weeklyBiography && {
  imageUrl: weeklyBiography.mainImage?.asset?.url,
  icon: weeklyBiography.mainImage?.asset?.url ? undefined : '🎩',
  label: 'Ukens tryllekunstner',
  title: weeklyBiography.artistName ?? weeklyBiography.name,
  description: weeklyBiography.shortBio,
  href: `/tryllehistorie/magiens-hvem-er-hvem/${weeklyBiography.slug}`,
}
---

<BaseLayout
  title="Tryllehistorie — Tryllemuseet"
  description={page.hero.ingress}
>

  <!-- HERO ──────────────────────────────────────────────────────── -->
  <PageHero label={page.hero.label} title={page.hero.heading} intro={page.hero.ingress} theme="dark" />

  <!-- VÅR HISTORISKE FORTELLING ─────────────────────────────────── -->
  <section class="th-story" aria-labelledby="th-story-heading">
    <div class="container th-story-inner">
      <p class="section-label">Vår historiske fortelling</p>
      <h2 class="display-title th-story-title" id="th-story-heading">Magiens historie — kort fortalt</h2>
      <p class="th-story-ingress">
        Tryllekunst er kanskje verdens eldste form for underholdning: kunsten å få
        andre mennesker til å undres. Fortellingen strekker seg fra faraoenes hoff
        til dagens talentshow — og hele veien er det den samme gnisten som driver
        den.
      </p>

      <div class="th-story-prose">
        <h3 class="th-story-kicker">De første undrene</h3>
        <p>
          Lenge før det fantes teatre og TV, samlet folk seg rundt gjøglere som fikk
          små kuler til å forsvinne under begre. Begerspillet — verdens eldste
          kjente trylletriks — ble avbildet i Egypt for rundt fire tusen år siden,
          og en gammel nedtegnelse forteller om magikeren Dedi, som skal ha
          opptrådt for selveste farao Khufu. Trangen til å bli forundret er med
          andre ord like gammel som sivilisasjonen selv.
        </p>

        <h3 class="th-story-kicker">Gjøglere i farlige tider</h3>
        <p>
          I middelalderens Europa levde tryllekunsten på markedsplassene, blant
          gjøglere og omreisende artister. Men kunsten kunne være livsfarlig: Den
          som var for flink med hendene, risikerte å bli anklaget for trolldom. Da
          engelskmannen Reginald Scot i 1584 ga ut «The Discoverie of Witchcraft»,
          var det nettopp for å vise at taskenspillernes triks var fingerferdighet
          — ikke djevelskap. Boken ble samtidig den første trykte forklaringen på
          hvordan triksene gjøres.
        </p>

        <h3 class="th-story-kicker">Fra markedsbod til teatersal</h3>
        <p>
          Utover 1700- og 1800-tallet flyttet magien innendørs. Den franske
          urmakeren Jean-Eugène Robert-Houdin åpnet sitt eget teater i Paris i 1845
          og kledde tryllekunsten i kjole og hvitt: eleganse, mekaniske
          underverker og vitenskapens språk i stedet for gjøglerens kappe. Den
          moderne scenetryllingen var født — og en ung amerikaner valgte senere
          kunstnernavnet Houdini til ære for ham.
        </p>

        <h3 class="th-story-kicker">Gullalderen</h3>
        <p>
          Tiårene fra midten av 1800-tallet til rundt 1930 kalles gjerne magiens
          gullalder. Herrmann, Kellar, Thurston og Houdini fylte de største
          scenene i verden, reiste på turné med tonnevis av illusjoner og kjempet
          om publikums gunst med praktfulle litografiske plakater. Også i Norge
          lot man seg fortrylle — en ung Henrik Ibsen holdt sine egne
          trylleforestillinger hjemme i Skien, og verdensstjernene fant veien til
          norske scener.
        </p>

        <h3 class="th-story-kicker">Nedgang — og nytt liv</h3>
        <p>
          Så kom filmen, radioen og etter hvert fjernsynet, og de store
          illusjonsshowene mistet publikum. Men magien døde ikke — den tilpasset
          seg. Tryllekunstnerne samlet seg i foreninger som Magiske Cirkel Norge,
          stiftet i Oslo i 1928, kunsten fant nye hjem i TV-studioer og
          klubblokaler, og på 1990-tallet førte gatemagien trolldommen helt ut på
          fortauet igjen — tett på publikum, akkurat som ved markedsbodene tusen
          år tidligere.
        </p>

        <h3 class="th-story-kicker">Historien fortsetter</h3>
        <p>
          I dag lever tryllekunsten i beste velgående — på teaterscener og i
          talentshow, i bursdagsselskaper og på skjermen. Og på Årvoll gård i Oslo
          tar Tryllemuseet vare på hele denne fortellingen: gjenstandene,
          plakatene, bøkene og menneskene som har viet livet til det umulige.
          Resten av historien finner du i arkivene nedenfor.
        </p>
      </div>

      <div class="th-story-actions">
        <Button variant="primary" href="/utstillingen">Se gullalderen i utstillingen</Button>
        <Button variant="outline" href="/tryllehistorie/fordypninger">Les fordypningene</Button>
      </div>
    </div>
  </section>

  <!-- SEKSJONER ───────────────────────────────────────────────────── -->
  <main class="container th-grid-wrap">
    <div class="th-grid">
      {page.seksjoner.map(s => (
        <ContentCard
          icon={s.emoji}
          label={`${s.sub} · ${s.badge}`}
          title={s.title}
          description={s.desc}
          href={s.soon ? undefined : s.href}
          ctaText={s.soon ? undefined : 'Utforsk →'}
          status={s.soon ? 'Kommer snart' : undefined}
        />
      ))}
    </div>

    <!-- FLERE OMRÅDER I ARKIVET (sikkerhetsnett fra siteNavigation) ── -->
    <HubSubnavGrid heading="Flere områder i arkivet" items={uncoveredSubAreas} />

    <!-- TIDSLINJE-TEASER ────────────────────────────────────────── -->
    <aside class="timeline-teaser">
      <h2 class="display-title timeline-title">{page.tidslinjeHeading}</h2>
      <div class="timeline">
        {page.tidslinje.map(item => (
          <div class:list={['tl-item', { 'tl-item--last': item.siste }]}>
            <span class="tl-year">{item.aar}</span>
            <span class="tl-event">{item.hendelse}</span>
          </div>
        ))}
      </div>
    </aside>

    <!-- UKENS TRYLLEKUNSTNER (auto content, roterer ukentlig) ─────── -->
    <AutoContentGrid
      heading="Ukens tryllekunstner"
      intro="Et nytt ansikt fra Magiens hvem er hvem, hver uke."
      items={weeklyBiographyItem ? [weeklyBiographyItem] : []}
    />

  </main>

</BaseLayout>

<style>
  /* ── VÅR HISTORISKE FORTELLING ─────────────────────────────────── */
  .th-story { background: white; border-bottom: 1px solid var(--cream-dark); padding: 3.5rem 0 4rem; }
  .th-story-inner { max-width: 720px; }
  .th-story-title { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0.5rem 0 1rem; }
  .th-story-ingress { font-family: var(--font-body); font-size: 1.1rem; font-style: italic; color: var(--ink-mid); line-height: 1.75; margin-bottom: 2rem; }

  .th-story-prose p { font-family: var(--font-body); font-size: 0.98rem; color: var(--ink-mid); line-height: 1.8; margin-bottom: 1.5rem; }
  .th-story-prose p:first-of-type::first-letter { font-family: var(--font-display); font-size: 3.2rem; float: left; line-height: 0.85; padding: 0.1em 0.12em 0 0; color: var(--burgundy); }

  .th-story-kicker { font-family: var(--font-ui); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--gold-dark); margin-bottom: 0.4rem; }

  .th-story-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }

  /* ── GRID ──────────────────────────────────────────────────────── */
  .th-grid-wrap { padding-top: 3rem; padding-bottom: 5rem; }

  .th-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  /* ── TIDSLINJE ─────────────────────────────────────────────────── */
  .timeline-teaser {
    background: var(--burgundy-dk);
    border-radius: 8px;
    padding: 2.5rem 2.5rem 2rem;
    color: var(--cream);
  }

  .timeline-title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--gold);
    margin-bottom: 2rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 88px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(212,168,67,0.25);
  }

  .tl-item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.25rem;
    padding: 0.6rem 0 0.6rem 0;
    position: relative;
  }

  .tl-item::before {
    content: '';
    position: absolute;
    left: 83px;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    background: var(--gold);
    border-radius: 50%;
    border: 2px solid var(--burgundy-dk);
  }

  .tl-item--last::before { background: var(--gold-light); }

  .tl-year {
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--gold);
    text-align: right;
    padding-right: 1.5rem;
    line-height: 1.4;
    padding-top: 0.1rem;
  }

  .tl-event {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--cream);
    opacity: 0.85;
    line-height: 1.5;
    padding-left: 1rem;
  }

  /* ── RESPONSIVE ────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .th-grid { grid-template-columns: 1fr; }

    .timeline::before { left: 70px; }
    .tl-item { grid-template-columns: 70px 1fr; }
    .tl-item::before { left: 65px; }

    .timeline-teaser { padding: 1.5rem 1.25rem; }
  }
</style>
