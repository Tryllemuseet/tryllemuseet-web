---
// src/pages/tryllehistorie/fordypninger/magic-club/index.astro
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getMagicClubEditions } from '../../../../lib/sanity'
import type { MagicClubEdition } from '../../../../lib/sanity'

const editions = await getMagicClubEditions()
const total = editions.length

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })
}
---

<BaseLayout
  title="Magic Club — Tryllemuseet"
  description="Historien om Magic Club — Oslos faste magikerkveld, skapt og hostet av Davido siden 2015."
>

  <!-- HERO ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/tryllehistorie">Tryllehistorie</a>
        <span>›</span>
        <a href="/tryllehistorie/fordypninger">Fordypninger</a>
      </nav>
      <h1 class="display-title hero-title">Magic Club</h1>
      <p class="hero-sub">
        {total > 0
          ? `${total} kveld${total === 1 ? '' : 'er'} dokumentert — Oslos faste magikerkveld, skapt og hostet av Davido siden 2015.`
          : 'Oslos faste magikerkveld, skapt og hostet av Davido siden 2015. Arkivet bygges fortløpende.'}
      </p>
    </div>
  </section>

  {editions.length === 0 ? (
    <div class="container empty-state">
      <p>Ingen kvelder er registrert ennå.</p>
    </div>
  ) : (
    <main class="container edition-grid">
      {editions.map((ed: MagicClubEdition) => (
        <article class="edition-card">
          <a href={`/tryllehistorie/fordypninger/magic-club/${ed.slug}`} class="edition-link">
            <div class="edition-img">
              {ed.poster?.asset?.url ? (
                <img src={ed.poster.asset.url} alt={ed.poster.alt ?? `Plakat, Magic Club ${formatDate(ed.date)}`} loading="lazy" />
              ) : (
                <div class="edition-img-placeholder" aria-hidden="true">🎩</div>
              )}
            </div>
            <div class="edition-body">
              <p class="edition-date">{formatDate(ed.date)}</p>
              <p class="edition-venue">{ed.venue}</p>
              {ed.guestStars && ed.guestStars.length > 0 && (
                <p class="edition-guests">Gjest: {ed.guestStars.map(g => g.name).join(', ')}</p>
              )}
            </div>
          </a>
        </article>
      ))}
    </main>
  )}

  <div class="container page-nav">
    <a href="/tryllehistorie/fordypninger">← Fordypninger</a>
    <a href="/tryllehistorie">← Tryllehistorie</a>
  </div>

</BaseLayout>

<style>
  .hero { padding: 3.5rem 0 2.5rem; }
  .breadcrumb { display: flex; gap: 0.5rem; align-items: center; font-family: var(--font-ui); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1rem; }
  .breadcrumb a { color: var(--burgundy); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: var(--grey); }
  .hero-title { font-size: clamp(1.8rem, 5vw, 3rem); margin: 0.5rem 0 0.75rem; }
  .hero-sub { font-family: var(--font-ui); font-size: 1rem; color: var(--ink-mid); max-width: 620px; }

  .empty-state { padding: 2rem 0 3rem; font-family: var(--font-ui); color: var(--ink-mid); }

  .edition-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    padding-block: 1rem 3rem;
  }

  .edition-card { background: white; border: 1px solid var(--cream-dark); border-radius: 8px; overflow: hidden; transition: box-shadow 150ms, border-color 150ms; }
  .edition-card:hover { box-shadow: 0 4px 20px rgba(26,18,8,0.1); border-color: var(--gold); }
  .edition-link { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); height: 100%; }

  .edition-img { width: 100%; aspect-ratio: 3/4; overflow: hidden; background: var(--burgundy-dk); flex-shrink: 0; }
  .edition-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms; }
  .edition-card:hover .edition-img img { transform: scale(1.03); }
  .edition-img-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 3rem; background: linear-gradient(160deg, var(--burgundy-dk), #2a1208); }

  .edition-body { padding: 1.1rem 1.25rem 1.25rem; }
  .edition-date { font-family: var(--font-display); font-size: 1.05rem; color: var(--burgundy); line-height: 1.3; }
  .edition-venue { font-family: var(--font-ui); font-size: 0.8rem; color: var(--gold-dark); font-weight: 600; letter-spacing: 0.03em; margin-top: 0.2rem; }
  .edition-guests { font-family: var(--font-body); font-size: 0.85rem; color: #555; margin-top: 0.5rem; }

  .page-nav { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 1.5rem 0 3rem; font-family: var(--font-ui); font-size: 0.875rem; }
  .page-nav a { color: var(--grey); text-decoration: none; border: 1px solid var(--cream-dark); padding: 0.4rem 1rem; border-radius: var(--radius); transition: color 150ms, border-color 150ms; }
  .page-nav a:hover { color: var(--burgundy); border-color: var(--gold); }

  @media (max-width: 560px) {
    .edition-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
