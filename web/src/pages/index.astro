---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro'
import AnimateIn from '../components/AnimateIn.astro'
import MentionedMagicians from '../components/MentionedMagicians.astro'
import { getGullalderenPanels, getUpcomingEvents, getHomepage, getSiteConfig, getAllPartners, getLatestHistoriskKlipp, getLatestStory, getFeaturedMediaAppearance, getFrontpageWhoKnew, urlFor } from '../lib/sanity'

const today = new Date().toISOString().split('T')[0]

const mediaTypeLabels: Record<string, string> = {
  avis: 'Avis', nettavis: 'Nettavis', tv: 'TV', radio: 'Radio', podkast: 'Podkast',
}
const [gullalderenPanels, events, hp, config, partners, latestClipping, latestStory, featuredMedia, whoKnewEntries] = await Promise.all([
  getGullalderenPanels(),
  getUpcomingEvents(3),
  getHomepage(),
  getSiteConfig(),
  getAllPartners(),
  getLatestHistoriskKlipp(),
  getLatestStory(),
  getFeaturedMediaAppearance(today),
  getFrontpageWhoKnew(3),
])

const categoryLabels: Record<string, string> = {
  vitenskap: 'Vitenskap', politikk: 'Politikk & samfunn', sport: 'Sport', kultur: 'Kultur & underholdning',
}

// ── Fallback-verdier ─────────────────────────────────────────────
const kurs = hp?.kursSeksjon ?? {
  heading:    'Tryllekurs for barn',
  ingress:    'Du lærer triks som er enkle å utføre, men som virker meget imponerende. Kursene går over tre ettermiddager annenhver uke.',
  detaljer:   [
    'Aldersgrupper: 6–8 år (kl. 17) · 9–12 år (kl. 18.30) · 13+ år (kl. 20)',
    'Kun 14 plasser per kurs — «først til mølla»',
    'Inkluderer kursmateriell og tryllerekvisitter',
  ],
  pris:       'kr 50',
  prisLabel:  'per kurs',
  fondsBadge: 'Støttet av Oslo kommunes Regionalt kulturfond',
  knappLabel: 'Se kommende kurs',
  knappHref:  '/aktiviteter',
}
const kursSitat = hp?.kursSitat ?? {
  tekst:  'Vil bare takke for et utrolig gøyalt tryllekurs — han koste seg!',
  kilde:  'Mor til kursdeltaker, 8 år · Januar 2026',
}
const barn = hp?.barnSeksjon ?? {
  heading:  'Magi du kan ta på og prøve',
  ingress:  'Den nedre delen av utstillingen er laget spesielt for barn.',
  features: ['Hunder utkledd som løver og tigre', 'Prøv å unnslippe som Houdini', 'Plasma-kule du kan styre med fingrene', 'Ta med en tegning hjem'],
  sitater:  [
    { emoji: '🐕', tekst: 'Adelaide hadde hunder utkledd som løver og tigre i showet sitt!', kilde: 'Fra barnefeltet — Adelaide Herrmann' },
    { emoji: '⚡', tekst: 'Legg hånden mot kulen — ser du at lysstrålene følger fingrene dine?', kilde: 'Fra barnefeltet — Plasma-kulen' },
  ],
}
const medlem = hp?.medlemSeksjon ?? {
  heading:    'Bli medlem!',
  tekst:      'Som medlem støtter du Tryllemuseet og bidrar til å holde magien levende for kommende generasjoner.',
  knappLabel: 'Bli medlem nå →',
}
const om = hp?.omMuseet ?? {
  heading:    'Fra Munkedamsveien til Årvoll gård',
  tekst:      'Den 9. desember 2001 åpnet daværende Oslo-ordfører Albert Nordengen dørene til Norsk Tryllemuseum i Munkedamsveien. Etter flere flyttinger og mange år på lager ble museet gjenåpnet på Årvoll gård 1. desember 2024 — takket være frivillige ildsjeler som holdt magien i live.\n\nI 2025 feirer Tryllemuseet ett år på Årvoll gård og hele 24 år som museum. Vi holder til i låven, vegg i vegg med kaféen og Fjøset.',
  sitat:      'Det umulige er bare det vi ikke har lært å gjøre ennå.',
  sitatKilde: '— Robert-Houdin',
}

function formatTime(d: string) {
  return new Date(d).toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit' })
}

// ── Hero: bannerkarusell (appetittvekkere) ───────────────────────
// Editor-managed heroBannere from Sanity drive the top carousel; until
// they are seeded, a hardcoded set of five teasers fills it. Each slide
// is a full-bleed image/video with a short two-part text and a button.
type HeroBannerSlide = {
  href:      string
  line1:     string
  line2?:    string
  button?:   string
  imgUrl:    string | null
  imgAlt:    string
  videoUrl?: string
}

const houdiniPanel = gullalderenPanels.find(p => p.slug === 'houdini')
const fallbackBanners: HeroBannerSlide[] = [
  {
    href: '/utstillingen/houdini',
    line1: 'Houdini',
    line2: 'Mannen ingen lenker kunne holde',
    button: 'Se utstillingen',
    imgUrl: houdiniPanel?.mainImage?.asset?._ref
      ? urlFor(houdiniPanel.mainImage.asset).width(1600).height(640).fit('crop').format('webp').url()
      : (houdiniPanel?.mainImage?.asset?.url ?? null),
    imgAlt: houdiniPanel?.mainImage?.alt ?? 'Houdini',
  },
  { href: '/barn',          line1: 'Magi for barn',                 line2: 'Ta på, prøv selv — magi du kan oppleve med hendene', button: 'Utforsk barnesiden',  imgUrl: null, imgAlt: '' },
  { href: '/aktiviteter',   line1: 'Tryllekurs og arrangementer',   line2: 'Lær triks som imponerer — kurs for barn fra 6 år',   button: 'Se hva som skjer',    imgUrl: null, imgAlt: '' },
  { href: '/tryllehistorie',line1: '4000 år med magi',              line2: 'Fra faraoens hoff til norske scener',                button: 'Utforsk historien',   imgUrl: null, imgAlt: '' },
  { href: '/tryllehistorie/magiens-hvem-er-hvem', line1: 'Magiens hvem er hvem', line2: 'Norske tryllekunstnere fra A til Å',    button: 'Bla i registeret',    imgUrl: null, imgAlt: '' },
]

const heroBanners: HeroBannerSlide[] = hp?.heroBannere?.length
  ? hp.heroBannere.map((b): HeroBannerSlide => ({
      href:   b.href,
      line1:  b.tekstLinje1,
      line2:  b.tekstLinje2,
      button: b.knappLabel,
      imgUrl: b.bilde?.asset?._ref
        ? urlFor(b.bilde).width(1600).height(640).fit('crop').format('webp').url()
        : (b.bilde?.asset?.url ?? null),
      imgAlt: b.bilde?.alt ?? b.tekstLinje1,
      videoUrl: b.videoUrl,
    }))
  : fallbackBanners
---

<BaseLayout title="Tryllemuseet — Norges mest magiske museum">

  <!-- ══ HERO — bannerkarusell ═══════════════════════════════════ -->
  <section class="hero-banner" aria-label="Utvalgt innhold">
    <h1 class="sr-only">Tryllemuseet — {config.siteTagline}</h1>

    <div class="banner-track">
      {heroBanners.map((b, i) => (
        <a href={b.href}
           class:list={['banner-slide', { 'is-active': i === 0 }]}
           data-banner-slide
           aria-hidden={i === 0 ? undefined : 'true'}
           tabindex={i === 0 ? undefined : -1}>
          <div class="banner-media" aria-hidden="true">
            {b.videoUrl ? (
              <video src={b.videoUrl} autoplay muted loop playsinline preload={i === 0 ? 'auto' : 'none'}></video>
            ) : b.imgUrl ? (
              <img src={b.imgUrl} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
            ) : (
              <div class="banner-stars"></div>
            )}
            <div class="banner-scrim"></div>
          </div>
          <div class="banner-content">
            <p class="banner-line1">{b.line1}</p>
            {b.line2 && <p class="banner-line2">{b.line2}</p>}
            {b.button && <span class="banner-btn">{b.button}</span>}
          </div>
        </a>
      ))}
    </div>

    {heroBanners.length > 1 && (
      <>
        <button type="button" class="banner-arrow banner-arrow--prev" id="banner-prev" aria-label="Forrige banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="banner-arrow banner-arrow--next" id="banner-next" aria-label="Neste banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <div class="banner-dots" role="tablist" aria-label="Velg banner">
          {heroBanners.map((b, i) => (
            <button type="button"
                    class:list={['banner-dot', { 'is-active': i === 0 }]}
                    role="tab" aria-selected={i === 0 ? 'true' : 'false'}
                    aria-label={b.line1} data-banner-dot></button>
          ))}
        </div>
      </>
    )}
  </section>

  <!-- ══ BESØKSLINJE (komprimert) ════════════════════════════════ -->
  <section class="visit-line" aria-label="Praktisk informasjon">
    <div class="container visit-line-inner">
      <span>{config.openingHoursShort}</span>
      <span class="visit-line-sep" aria-hidden="true">·</span>
      <span>{config.addressShort}</span>
      <span class="visit-line-sep" aria-hidden="true">·</span>
      <span>Gratis inngang</span>
      <a href="/besok" class="visit-line-link">Planlegg besøket →</a>
    </div>
  </section>

  <!-- ══ ARRANGEMENTER ═══════════════════════════════════════════ -->
  <section class="section events-section" aria-labelledby="events-heading">
    <div class="container">
      <AnimateIn direction="up">
        <div class="section-header">
          <div>
            <p class="section-label">Kalender</p>
            <h2 class="display-title section-title" id="events-heading">Kommende arrangementer</h2>
          </div>
          <a href="/aktiviteter" class="btn-outline">Se alle</a>
        </div>
      </AnimateIn>
      {events.length > 0 ? (
        <AnimateIn direction="up">
        <div class="events-grid">
          {events.map((event) => (
            <article class="event-card">
              <div class="event-date-block">
                <span class="event-day">{new Date(event.date).getDate()}</span>
                <span class="event-month">{new Date(event.date).toLocaleDateString('nb-NO', { month: 'short' })}</span>
              </div>
              <div class="event-body">
                <div class="event-meta">
                  {event.ageGroup && <span class="event-tag">{event.ageGroup}</span>}
                  <span class="event-time">{formatTime(event.date)}</span>
                  {event.price && <span class="event-price">{event.price}</span>}
                </div>
                <h3 class="event-title"><a href="/aktiviteter">{event.title}</a></h3>
                {event.excerpt && <p class="event-excerpt">{event.excerpt}</p>}
              </div>
              {event.bookingUrl && (
                <a href={event.bookingUrl} target="_blank" rel="noopener noreferrer"
                   class="event-book" aria-label={`Meld deg på ${event.title}`}>Meld på →</a>
              )}
            </article>
          ))}
        </div>
        </AnimateIn>
      ) : (
        <AnimateIn direction="up">
        <div class="no-events">
          <p>Ingen kommende arrangementer akkurat nå. Følg oss på
            <a href={config.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> for oppdateringer.
          </p>
        </div>
        </AnimateIn>
      )}
    </div>
  </section>

  <hr class="gold-rule container" />

  <!-- ══ HVEM SKULLE TRODD? ══════════════════════════════════════ -->
  {whoKnewEntries.length > 0 && (
    <>
      <section class="section whoknew-section" aria-labelledby="whoknew-heading">
        <div class="container">
          <AnimateIn direction="up">
            <div class="section-header">
              <div>
                <p class="section-label">Visste du at…</p>
                <h2 class="display-title section-title" id="whoknew-heading">Hvem skulle trodd?</h2>
              </div>
              <a href="/tryllehistorie/hvem-skulle-trodd" class="btn-outline">Se alle</a>
            </div>
          </AnimateIn>
          <AnimateIn direction="up">
            <div class="whoknew-grid">
              {whoKnewEntries.map((w) => (
                <a href={`/tryllehistorie/hvem-skulle-trodd/${w.slug}`} class="whoknew-card" aria-label={`Les mer om ${w.name}`}>
                  <div class="whoknew-img">
                    {w.image?.asset?.url
                      ? <img src={w.image.asset.url} alt={w.image.alt ?? w.name} loading="lazy" />
                      : <div class="whoknew-img-placeholder" aria-hidden="true">🎩</div>
                    }
                    <span class="whoknew-category">{categoryLabels[w.category] ?? w.category}</span>
                  </div>
                  <div class="whoknew-body">
                    <h3 class="whoknew-name">{w.name}</h3>
                    <p class="whoknew-hook">{w.hook}</p>
                    <span class="whoknew-link-hint">Les mer →</span>
                  </div>
                </a>
              ))}
            </div>
          </AnimateIn>
        </div>
      </section>

      <hr class="gold-rule container" />
    </>
  )}

  <!-- ══ UKENS HISTORIE ═════════════════════════════════════════ -->
  {latestStory && (
    <>
      <section class="section press-section" aria-labelledby="story-heading">
        <div class="container press-inner">
          <AnimateIn direction="left">
          <div class="press-text">
            <p class="section-label">Ukens historie</p>
            <h2 class="display-title section-title" id="story-heading">{latestStory.title}</h2>
            <p class="press-meta">{new Date(latestStory.publishedAt).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <p class="press-teaser">{latestStory.teaser}</p>
            <MentionedMagicians magicians={latestStory.mentionedMagicians} />
            <div class="press-actions">
              <a href={`/tryllehistorie/historier/${latestStory.slug}`} class="btn-primary">
                Les historien →
              </a>
              <a href="/tryllehistorie/historier" class="btn-outline">
                Alle historiene
              </a>
            </div>
          </div>
          </AnimateIn>
          {latestStory.image?.asset?.url && (
            <AnimateIn direction="right">
            <div class="press-image">
              <img
                src={latestStory.image.asset.url}
                alt={latestStory.image.alt ?? latestStory.title}
                loading="lazy"
              />
            </div>
            </AnimateIn>
          )}
        </div>
      </section>
      <hr class="gold-rule container" />
    </>
  )}

  <!-- ══ UKENS HISTORISKE ARTIKKEL ══════════════════════════════ -->
  {latestClipping && (
    <section class="section press-section" aria-labelledby="press-heading">
      <div class="container press-inner">
        <AnimateIn direction="left">
        <div class="press-text">
          <p class="section-label">Ukens historiske artikkel</p>
          <h2 class="display-title section-title" id="press-heading">{latestClipping.title}</h2>
          {(latestClipping.sourceName || latestClipping.originalDate) && (
            <p class="press-meta">
              {latestClipping.sourceName && <span>{latestClipping.sourceName}</span>}
              {latestClipping.sourceName && latestClipping.originalDate && <span aria-hidden="true"> · </span>}
              {latestClipping.originalDate && <span>{new Date(latestClipping.originalDate).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })}</span>}
            </p>
          )}
          <p class="press-teaser">{latestClipping.teaser}</p>
          <MentionedMagicians magicians={latestClipping.mentionedMagicians} />
          <div class="press-actions">
            <a href={latestClipping.sourceUrl} target="_blank" rel="noopener" class="btn-primary">
              Les hos Nasjonalbiblioteket →
            </a>
            <a href="/tryllehistorie/historiske-artikler" class="btn-outline">
              Se arkivet
            </a>
          </div>
        </div>
        </AnimateIn>
        {latestClipping.images?.[0]?.asset?.url && (
          <AnimateIn direction="right">
          <div class="press-image">
            <img
              src={latestClipping.images[0].asset.url}
              alt={latestClipping.images[0].alt ?? latestClipping.title}
              loading="lazy"
            />
          </div>
          </AnimateIn>
        )}
      </div>
    </section>
  )}

  {featuredMedia && (
    <>
      <hr class="gold-rule container" />
      <!-- ══ MUSEET I MEDIA ══════════════════════════════════════════ -->
      <section class="section media-section" aria-labelledby="media-heading">
        <div class="container media-inner">
          <AnimateIn direction="left">
          <div class="media-text">
            <p class="section-label">Museet i media</p>
            <span class="media-type-badge">{mediaTypeLabels[featuredMedia.type] ?? featuredMedia.type}</span>
            <h2 class="display-title section-title" id="media-heading">{featuredMedia.title}</h2>
            <p class="media-meta">
              <span>{featuredMedia.sourceName}</span>
              {featuredMedia.publishedAt && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span>{new Date(featuredMedia.publishedAt).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                </>
              )}
            </p>
            {featuredMedia.quote && (
              <blockquote class="media-quote">
                <p>«{featuredMedia.quote}»</p>
                <cite>— {featuredMedia.sourceName}</cite>
              </blockquote>
            )}
            <p class="media-teaser">{featuredMedia.teaser}</p>
            <div class="media-actions">
              {featuredMedia.sourceUrl && (
                <a href={featuredMedia.sourceUrl} target="_blank" rel="noopener" class="btn-primary">
                  Les artikkelen →
                </a>
              )}
              <a href="/om-oss/i-media" class="btn-outline">Se all pressedekning</a>
            </div>
          </div>
          </AnimateIn>
          <AnimateIn direction="right">
          <div class="media-visual">
            {featuredMedia.videoId ? (
              <div class="media-video-wrap">
                <iframe
                  src={`https://www.youtube.com/embed/${featuredMedia.videoId}`}
                  title={featuredMedia.title}
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>
            ) : featuredMedia.image?.asset?.url ? (
              <div class="media-image">
                <img
                  src={featuredMedia.image.asset.url}
                  alt={featuredMedia.image.alt ?? featuredMedia.title}
                  loading="lazy"
                />
              </div>
            ) : null}
          </div>
          </AnimateIn>
        </div>
      </section>
    </>
  )}

  <hr class="gold-rule container" />

  <!-- ══ KURS ════════════════════════════════════════════════════ -->
  <section class="section kurs-section" aria-labelledby="kurs-heading">
    <div class="container kurs-inner">
      <AnimateIn direction="left">
      <div class="kurs-text">
        <p class="section-label">Aktuelt nå</p>
        <h2 class="display-title section-title" id="kurs-heading">{kurs.heading}</h2>
        <p class="kurs-ingress">{kurs.ingress}</p>
        <ul class="kurs-list">
          {kurs.detaljer.map((d: string) => (
            <li><span aria-hidden="true">✦</span> {d}</li>
          ))}
        </ul>
        <div class="kurs-pris">
          <span class="kurs-pris-tall">{kurs.pris}</span>
          <span class="kurs-pris-label">{kurs.prisLabel}</span>
        </div>
        <a href={kurs.knappHref} class="btn-primary" style="display:inline-block;margin-top:0.25rem">
          {kurs.knappLabel}
        </a>
        <p class="kurs-fonds">{kurs.fondsBadge}</p>
      </div>
      </AnimateIn>
      <AnimateIn direction="right">
      <div class="kurs-sitat-wrap">
        <div class="kurs-sitat">
          <p class="kurs-sitat-tekst">«{kursSitat.tekst}»</p>
          <p class="kurs-sitat-kilde">— {kursSitat.kilde}</p>
        </div>
      </div>
      </AnimateIn>
    </div>
  </section>

<!-- ══ SPONSORER ═══════════════════════════════════════════════ -->
{partners.length > 0 && (
  <section class="sponsors-section" aria-label="Støttespillere">
    <div class="container sponsors-inner">
      <AnimateIn direction="up">
      <div class="sponsors-groups">
        {(
          [
            { label: 'Prosjektstøtte',        cats: ['public', 'private'] as const },
            { label: 'Samarbeidspartnere',     cats: ['org']               as const },
            { label: 'Fordeler for medlemmer', cats: ['benefit']           as const },
          ] as { label: string; cats: (typeof partners[0]['category'])[] }[]
        ).map(({ label, cats }) => {
            const gruppe = partners.filter(p => cats.includes(p.category))
            if (!gruppe.length) return null
            return (
              <div class="sponsors-group">
                <p class="sponsors-label">{label}</p>
                <div class="sponsors-logos">
                  {gruppe.map(p => (
                    <button
                      class="sponsor-item"
                      aria-label={`Les mer om ${p.name}`}
                      data-name={p.name}
                      data-description={p.description ?? ''}
                      data-url={p.url ?? ''}
                      data-logo={p.logo?.asset?.url ?? ''}
                    >
                      <div class="sponsor-logo-wrap">
                        {p.logo?.asset?.url
                          ? <img src={p.logo.asset.url} alt="" class="sponsor-logo" loading="lazy" />
                          : <span class="sponsor-initial">{p.name.charAt(0)}</span>
                        }
                      </div>
                      <span class="sponsor-name">{p.name}</span>
                      <span class="sponsor-info-hint" aria-hidden="true">ℹ</span>
                    </button>
                  ))}
                </div>
              </div>
            )
          })
        }
      </div>
      </AnimateIn>
    </div>
  </section>
)}

<!-- ══ PARTNER-POPUP ══════════════════════════════════════════ -->
<div id="partner-popup" class="partner-popup" role="dialog" aria-modal="true" aria-labelledby="popup-name" hidden>
  <div class="partner-popup-backdrop"></div>
  <div class="partner-popup-card">
    <div class="popup-header">
      <button class="partner-popup-close" aria-label="Lukk">&#x2715;</button>
    </div>
    <div class="popup-body">
      <div id="popup-logo-wrap" class="popup-logo-wrap"></div>
      <h3 id="popup-name" class="popup-name"></h3>
      <p id="popup-description" class="popup-description"></p>
      <a id="popup-link" href="#" target="_blank" rel="noopener noreferrer" class="btn-ghost popup-link" hidden>Besøk nettside ↗</a>
    </div>
  </div>
</div>


  <hr class="gold-rule container" />

  <!-- ══ FOR BARN ════════════════════════════════════════════════ -->
  <section class="section kids-section" aria-labelledby="kids-heading">
    <div class="container kids-inner">
      <AnimateIn direction="left">
      <div class="kids-text">
        <p class="section-label">For de minste</p>
        <h2 class="display-title section-title" id="kids-heading">{barn.heading}</h2>
        <p class="kids-sub">{barn.ingress}</p>
        <ul class="kids-list">
          {barn.features.map((f) => (
            <li><span aria-hidden="true">✦</span> {f}</li>
          ))}
        </ul>
        <a href="/barn" class="btn-primary" style="margin-top:1.5rem;display:inline-block">
          Les mer for barn og unge
        </a>
      </div>
      </AnimateIn>
      <AnimateIn direction="right">
      <div class="kids-cards">
        {barn.sitater.map((s, i) => (
