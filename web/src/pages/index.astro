---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro'
import AnimateIn from '../components/AnimateIn.astro'
import SectionHeader from '../components/SectionHeader.astro'
import Button from '../components/Button.astro'
import ContentCard from '../components/ContentCard.astro'
import EventCard from '../components/EventCard.astro'
import { getGullalderenPanels, getUpcomingEvents, getHomepage, getSiteConfig, getAllPartners, getLatestHistoriskKlipp, getLatestStory, getFeaturedMediaAppearance, getFrontpageWhoKnew, getMonthlyLegendPick, getMonthlyBiographyPick, getMonthlyArtifactPick, getOnThisDayClippings, featuredItemHref, urlFor } from '../lib/sanity'

const today = new Date().toISOString().split('T')[0]

const mediaTypeLabels: Record<string, string> = {
  avis: 'Avis', nettavis: 'Nettavis', tv: 'TV', radio: 'Radio', podkast: 'Podkast',
}

// Data fetching is unchanged from before the redesign — every query below is
// still used somewhere (either rendered directly, or folded into the "Historie
// og aktuelt" pool below). whoKnewEntries/onThisDayClippings no longer get
// their own homepage section, but stay fully fetched and browsable on their
// own pages (/tryllehistorie/hvem-skulle-trodd, /tryllehistorie/historiske-artikler).
const [gullalderenPanels, events, hp, config, partners, latestClipping, latestStory, featuredMedia, whoKnewEntries, monthlyLegendFallback, monthlyBiography, monthlyArtifact, onThisDayClippings] = await Promise.all([
  getGullalderenPanels(),
  getUpcomingEvents(3),
  getHomepage(),
  getSiteConfig(),
  getAllPartners(),
  getLatestHistoriskKlipp(),
  getLatestStory(),
  getFeaturedMediaAppearance(today),
  getFrontpageWhoKnew(3),
  getMonthlyLegendPick(),
  getMonthlyBiographyPick(),
  getMonthlyArtifactPick(),
  getOnThisDayClippings(),
])
void whoKnewEntries
void onThisDayClippings

// «Fremhevet innhold» — redaktørens kuratering fra Sanity (hp.fremhevetInnhold),
// eller et automatisk månedsplukk fra fordypningene når feltet står tomt.
const fremhevet = (hp?.fremhevetInnhold?.elementer?.length ?? 0) > 0
  ? hp!.fremhevetInnhold
  : monthlyLegendFallback
    ? { eraLabel: undefined, heading: 'Fra arkivet', elementer: [monthlyLegendFallback] }
    : null

// ── Fallback-verdier ─────────────────────────────────────────────
const kurs = hp?.kursSeksjon ?? {
  heading:    'Tryllekurs for barn',
  ingress:    'Du lærer triks som er enkle å utføre, men som virker meget imponerende. Kursene går over tre ettermiddager annenhver uke.',
  detaljer:   [
    'Aldersgrupper: 6–8 år (kl. 17) · 9–12 år (kl. 18.30) · 13+ år (kl. 20)',
    'Kun 14 plasser per kurs — «først til mølla»',
    'Inkluderer kursmateriell og tryllerekvisitter',
  ],
  pris:       'kr 50',
  prisLabel:  'per kurs',
  fondsBadge: 'Støttet av Oslo kommunes Regionalt kulturfond',
  knappLabel: 'Se kommende kurs',
  knappHref:  '/aktiviteter',
}
const barn = hp?.barnSeksjon ?? {
  heading:  'Magi du kan ta på og prøve',
  ingress:  'Den nedre delen av utstillingen er laget spesielt for barn.',
  features: ['Hunder utkledd som løver og tigre', 'Prøv å unnslippe som Houdini', 'Plasma-kule du kan styre med fingrene', 'Ta med en tegning hjem'],
}
const medlem = hp?.medlemSeksjon ?? {
  heading:    'Bli medlem!',
  tekst:      'Som medlem støtter du Tryllemuseet og bidrar til å holde magien levende for kommende generasjoner.',
  knappLabel: 'Bli medlem nå →',
}
const om = hp?.omMuseet ?? {
  heading:    'Fra Munkedamsveien til Årvoll gård',
  tekst:      'Den 9. desember 2001 åpnet daværende Oslo-ordfører Albert Nordengen dørene til Norsk Tryllemuseum i Munkedamsveien. Etter flere flyttinger og mange år på lager ble museet gjenåpnet på Årvoll gård 1. desember 2024 — takket være frivillige ildsjeler som holdt magien i live.',
}

// ── Hero: bannerkarusell (appetittvekkere) ───────────────────────
// Editor-managed heroBannere from Sanity drive the top carousel; until
// they are seeded, a hardcoded set of five teasers fills it. Each slide
// is a full-bleed image/video with a short two-part text and a button.
type HeroBannerSlide = {
  href:      string
  line1:     string
  line2?:    string
  button?:   string
  imgUrl:    string | null
  imgAlt:    string
  videoUrl?: string
}

const houdiniPanel = gullalderenPanels.find(p => p.slug === 'houdini')
const fallbackBanners: HeroBannerSlide[] = [
  {
    href: '/utstillingen/houdini',
    line1: 'Houdini',
    line2: 'Mannen ingen lenker kunne holde',
    button: 'Se utstillingen',
    imgUrl: houdiniPanel?.mainImage?.asset?._ref
      ? urlFor(houdiniPanel.mainImage.asset).width(1600).height(640).fit('crop').format('webp').url()
      : (houdiniPanel?.mainImage?.asset?.url ?? null),
    imgAlt: houdiniPanel?.mainImage?.alt ?? 'Houdini',
  },
  { href: '/barn',          line1: 'Magi for barn',                 line2: 'Ta på, prøv selv — magi du kan oppleve med hendene', button: 'Utforsk barnesiden',  imgUrl: null, imgAlt: '' },
  { href: '/aktiviteter',   line1: 'Tryllekurs og arrangementer',   line2: 'Lær triks som imponerer — kurs for barn fra 6 år',   button: 'Se hva som skjer',    imgUrl: null, imgAlt: '' },
  { href: '/tryllehistorie',line1: '4000 år med magi',              line2: 'Fra faraoens hoff til norske scener',                button: 'Utforsk historien',   imgUrl: null, imgAlt: '' },
  { href: '/tryllehistorie/magiens-hvem-er-hvem', line1: 'Magiens hvem er hvem', line2: 'Norske tryllekunstnere fra A til Å',    button: 'Bla i registeret',    imgUrl: null, imgAlt: '' },
]

const heroBanners: HeroBannerSlide[] = hp?.heroBannere?.length
  ? hp.heroBannere.map((b): HeroBannerSlide => ({
      href:   b.href,
      line1:  b.tekstLinje1,
      line2:  b.tekstLinje2,
      button: b.knappLabel,
      imgUrl: b.bilde?.asset?._ref
        ? urlFor(b.bilde).width(1600).height(640).fit('crop').format('webp').url()
        : (b.bilde?.asset?.url ?? null),
      imgAlt: b.bilde?.alt ?? b.tekstLinje1,
      videoUrl: b.videoUrl,
    }))
  : fallbackBanners

// ── «Dette kan du oppleve» — redaktørstyrt via hp.oppleveKort, med et
// innebygd fast utvalg av fire kort som fallback så lenge feltet er tomt ──
const fallbackOpplevKort = [
  {
    icon: '🎩',
    imageUrl: houdiniPanel?.mainImage?.asset?.url,
    label: 'Utstillingen',
    title: 'Houdini og gullalderen',
    description: 'Møt magiens gullalder — fra Robert-Houdin til Houdini — i låven på Årvoll gård.',
    href: '/utstillingen',
    ctaText: 'Se utstillingen →',
  },
  {
    icon: '🐕',
    label: 'For barn',
    title: barn.heading,
    description: barn.ingress,
    href: '/barn',
    ctaText: 'Utforsk barnesiden →',
  },
  {
    icon: '✨',
    label: 'Aktuelt nå',
    title: kurs.heading,
    description: kurs.ingress,
    href: kurs.knappHref,
    ctaText: kurs.knappLabel + ' →',
  },
  {
    icon: '📜',
    label: 'Magiens historie',
    title: 'Fra faraoenes hoff til i dag',
    description: '4000 år med undring — fortalt gjennom mennesker, gjenstander og historier.',
    href: '/tryllehistorie',
    ctaText: 'Utforsk historien →',
  },
]

const opplevKort = hp?.oppleveKort?.length
  ? hp.oppleveKort.map((k) => ({
      icon: k.icon,
      imageUrl: k.bilde?.asset?._ref
        ? urlFor(k.bilde).width(700).height(500).fit('crop').format('webp').url()
        : (k.bilde?.asset?.url ?? undefined),
      label: k.label,
      title: k.title,
      description: k.description,
      href: k.href,
      ctaText: k.knappTekst ? `${k.knappTekst} →` : undefined,
    }))
  : fallbackOpplevKort

// ── «Historie og aktuelt» — samlet fra flere innholdstyper ─────────
type ArchiveCard = {
  imageUrl?: string
  icon?: string
  label?: string
  title: string
  description?: string
  href: string
}

const archiveCandidates: ArchiveCard[] = []

if (fremhevet?.elementer?.length) {
  for (const item of fremhevet.elementer.slice(0, 2)) {
    const img = item._type === 'legend'
      ? item.mainImage?.asset?.url
      : item._type === 'historiskeKlippNb'
        ? item.images?.[0]?.asset?.url
        : (item.featuredImage?.asset?.url ?? item.thumbnailUrl)
    const kicker = item._type === 'legend'
      ? item.tagline
      : item._type === 'historiskeKlippNb'
        ? item.sourceName
        : (item.year ? String(item.year) : undefined)
    archiveCandidates.push({ imageUrl: img, icon: img ? undefined : '🎩', label: kicker, title: item.title, href: featuredItemHref(item) })
  }
}
if (monthlyBiography) {
  archiveCandidates.push({
    imageUrl: monthlyBiography.mainImage?.asset?.url,
    icon: monthlyBiography.mainImage?.asset?.url ? undefined : '🎩',
    label: 'Månedens magiker',
    title: monthlyBiography.artistName ?? monthlyBiography.name,
    description: monthlyBiography.shortBio,
    href: `/tryllehistorie/magiens-hvem-er-hvem/${monthlyBiography.slug}`,
  })
}
if (monthlyArtifact) {
  archiveCandidates.push({
    imageUrl: monthlyArtifact.mainImage?.asset?.url,
    icon: monthlyArtifact.mainImage?.asset?.url ? undefined : '🏺',
    label: 'Månedens artefakt',
    title: monthlyArtifact.title,
    description: monthlyArtifact.description,
    href: `/utstillingen/artefakter/${monthlyArtifact.slug}`,
  })
}
if (latestStory) {
  archiveCandidates.push({
    imageUrl: latestStory.image?.asset?.url,
    icon: latestStory.image?.asset?.url ? undefined : '📖',
    label: 'Ukens historie',
    title: latestStory.title,
    description: latestStory.teaser,
    href: `/tryllehistorie/historier/${latestStory.slug}`,
  })
}
if (latestClipping) {
  archiveCandidates.push({
    imageUrl: latestClipping.images?.[0]?.asset?.url,
    icon: latestClipping.images?.[0]?.asset?.url ? undefined : '🗞️',
    label: latestClipping.sourceName ?? 'Historisk klipp',
    title: latestClipping.title,
    description: latestClipping.teaser,
    href: '/tryllehistorie/historiske-artikler',
  })
}
if (featuredMedia) {
  archiveCandidates.push({
    imageUrl: featuredMedia.image?.asset?.url,
    icon: featuredMedia.image?.asset?.url ? undefined : '📰',
    label: mediaTypeLabels[featuredMedia.type] ?? featuredMedia.type,
    title: featuredMedia.title,
    description: featuredMedia.teaser,
    href: '/om-oss/i-media',
  })
}

const archiveCards = archiveCandidates.filter(c => c.title).slice(0, 4)
---

<BaseLayout title="Tryllemuseet — Norges mest magiske museum">

  <!-- ══ IDENTITET — permanent, uavhengig av karusellslide ════════ -->
  <section class="hero-identity" aria-label="Om museet">
    <div class="container hero-identity-inner">
      <h1 class="hero-identity-heading">
        Tryllemuseet <span>på Årvoll gård i Oslo</span>
      </h1>
      <a href="/besok" class="hero-identity-cta">Besøk oss →</a>
    </div>
  </section>

  <!-- ══ HERO — bannerkarusell ═══════════════════════════════════ -->
  <section class="hero-banner" aria-label="Utvalgt innhold">

    <div class="banner-track">
      {heroBanners.map((b, i) => (
        <a href={b.href}
           class:list={['banner-slide', { 'is-active': i === 0 }]}
           data-banner-slide
           aria-hidden={i === 0 ? undefined : 'true'}
           tabindex={i === 0 ? undefined : -1}>
          <div class="banner-media" aria-hidden="true">
            {b.videoUrl ? (
              <video src={b.videoUrl} autoplay muted loop playsinline preload={i === 0 ? 'auto' : 'none'}></video>
            ) : b.imgUrl ? (
              <img src={b.imgUrl} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
            ) : (
              <div class="banner-stars"></div>
            )}
            <div class="banner-scrim"></div>
          </div>
          <div class="banner-content">
            <p class="banner-line1">{b.line1}</p>
            {b.line2 && <p class="banner-line2">{b.line2}</p>}
            {b.button && <span class="banner-btn">{b.button}</span>}
          </div>
        </a>
      ))}
    </div>

    {heroBanners.length > 1 && (
      <>
        <button type="button" class="banner-arrow banner-arrow--prev" id="banner-prev" aria-label="Forrige banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="banner-arrow banner-arrow--next" id="banner-next" aria-label="Neste banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <div class="banner-dots" role="tablist" aria-label="Velg banner">
          {heroBanners.map((b, i) => (
            <button type="button"
                    class:list={['banner-dot', { 'is-active': i === 0 }]}
                    role="tab" aria-selected={i === 0 ? 'true' : 'false'}
                    aria-label={b.line1} data-banner-dot></button>
          ))}
        </div>
      </>
    )}
  </section>

  <!-- ══ BESØKSLINJE (komprimert) ════════════════════════════════ -->
  <section class="visit-line" aria-label="Praktisk informasjon">
    <div class="container visit-line-inner">
      <span>{config.openingHoursShort}</span>
      <span class="visit-line-sep" aria-hidden="true">·</span>
      <span>{config.addressShort}</span>
      <span class="visit-line-sep" aria-hidden="true">·</span>
      <span>Gratis inngang</span>
      <a href="/besok" class="visit-line-link">Planlegg besøket →</a>
    </div>
  </section>

  <!-- ══ ARRANGEMENTER ═══════════════════════════════════════════ -->
  <section class="section events-section" aria-labelledby="events-heading">
    <div class="container">
      <AnimateIn direction="up">
        <SectionHeader id="events-heading" label="Kalender" title="Kommende arrangementer" href="/aktiviteter" linkLabel="Se alle" />
      </AnimateIn>
      {events.length > 0 ? (
        <AnimateIn direction="up">
        <div class="events-grid">
          {events.map((event) => (
            <EventCard
              date={event.date}
              title={event.title}
              excerpt={event.excerpt}
              ageGroup={event.ageGroup}
              price={event.price}
              bookingUrl={event.bookingUrl}
              href="/aktiviteter"
            />
          ))}
        </div>
        </AnimateIn>
      ) : (
        <AnimateIn direction="up">
        <div class="no-events">
          <p>Ingen kommende arrangementer akkurat nå. Følg oss på
            <a href={config.facebook} target="_blank" rel="noopener noreferrer">Facebook</a> for oppdateringer.
          </p>
        </div>
        </AnimateIn>
      )}
    </div>
  </section>

  <hr class="gold-rule container" />

  <!-- ══ DETTE KAN DU OPPLEVE ═══════════════════════════════════ -->
  <section class="section opplev-section" aria-labelledby="opplev-heading">
    <div class="container">
      <AnimateIn direction="up">
        <SectionHeader id="opplev-heading" label="Museet" title="Dette kan du oppleve" alignment="center" />
      </AnimateIn>
      <AnimateIn direction="up">
        <div class="opplev-grid">
          {opplevKort.map((k) => (
            <ContentCard
              imageUrl={k.imageUrl}
              icon={k.imageUrl ? undefined : k.icon}
              label={k.label}
              title={k.title}
              description={k.description}
              href={k.href}
              ctaText={k.ctaText}
            />
          ))}
        </div>
      </AnimateIn>
    </div>
  </section>

  <hr class="gold-rule container" />

  <!-- ══ HISTORIE OG AKTUELT ═════════════════════════════════════ -->
  {archiveCards.length > 0 && (
    <>
      <section class="section archive-section" aria-labelledby="archive-heading">
        <div class="container">
          <AnimateIn direction="up">
            <SectionHeader id="archive-heading" label="Fra arkivet" title="Historie og aktuelt" href="/tryllehistorie" linkLabel="Utforsk mer" />
          </AnimateIn>
          <AnimateIn direction="up">
            <div class="archive-grid">
              {archiveCards.map((c) => (
                <ContentCard
                  imageUrl={c.imageUrl}
                  icon={c.icon}
                  label={c.label}
                  title={c.title}
                  description={c.description}
                  href={c.href}
                  ctaText="Les mer →"
                />
              ))}
            </div>
          </AnimateIn>
        </div>
      </section>

      <hr class="gold-rule container" />
    </>
  )}

  <!-- ══ STØTT MUSEET — medlemskap og donasjon, to atskilte valg ═══ -->
  <section class="section support-section" aria-labelledby="member-heading">
    <div class="container">
      <AnimateIn direction="up">
        <p class="section-label support-label">Støtt museet</p>
      </AnimateIn>
      <div class="support-grid">
        <AnimateIn direction="left">
          <div class="support-card">
            <h2 class="display-title" id="member-heading">{medlem.heading}</h2>
            <p>{medlem.tekst}</p>
            <Button variant="membership" href={config.membershipUrl}>{medlem.knappLabel}</Button>
          </div>
        </AnimateIn>
        <AnimateIn direction="right">
          <div class="support-card">
            <h2 class="display-title">Gi en gave</h2>
            <p>{config.donationText}</p>
            <Button variant="outline" class="support-donate-btn" href={config.donationUrl || '/om-oss#gi-en-gave'}>{config.donationLabel}</Button>
          </div>
        </AnimateIn>
      </div>
    </div>
  </section>

  <!-- ══ SPONSORER ═══════════════════════════════════════════════ -->
  {partners.length > 0 && (
    <section class="sponsors-section" aria-label="Støttespillere">
      <div class="container sponsors-inner">
        <AnimateIn direction="up">
        <div class="sponsors-groups">
          {(
            [
              { label: 'Prosjektstøtte',        cats: ['public', 'private'] as const },
              { label: 'Samarbeidspartnere',     cats: ['org']               as const },
              { label: 'Fordeler for medlemmer', cats: ['benefit']           as const },
            ] as { label: string; cats: (typeof partners[0]['category'])[] }[]
          ).map(({ label, cats }) => {
              const gruppe = partners.filter(p => cats.includes(p.category))
              if (!gruppe.length) return null
              return (
                <div class="sponsors-group">
                  <p class="sponsors-label">{label}</p>
                  <div class="sponsors-logos">
                    {gruppe.map(p => (
                      <button
                        class="sponsor-item"
                        aria-label={`Les mer om ${p.name}`}
                        data-name={p.name}
                        data-description={p.description ?? ''}
                        data-url={p.url ?? ''}
                        data-logo={p.logo?.asset?.url ?? ''}
                      >
                        <div class="sponsor-logo-wrap">
                          {p.logo?.asset?.url
                            ? <img src={p.logo.asset.url} alt="" class="sponsor-logo" loading="lazy" />
                            : <span class="sponsor-initial">{p.name.charAt(0)}</span>
                          }
                        </div>
                        <span class="sponsor-name">{p.name}</span>
                        <span class="sponsor-info-hint" aria-hidden="true">ℹ</span>
                      </button>
                    ))}
                  </div>
                </div>
              )
            })
          }
        </div>
        </AnimateIn>
      </div>
    </section>
  )}

  <!-- ══ PARTNER-POPUP ══════════════════════════════════════════ -->
  <div id="partner-popup" class="partner-popup" role="dialog" aria-modal="true" aria-labelledby="popup-name" hidden>
    <div class="partner-popup-backdrop"></div>
    <div class="partner-popup-card">
      <div class="popup-header">
        <button class="partner-popup-close" aria-label="Lukk">&#x2715;</button>
      </div>
      <div class="popup-body">
        <div id="popup-logo-wrap" class="popup-logo-wrap"></div>
        <h3 id="popup-name" class="popup-name"></h3>
        <p id="popup-description" class="popup-description"></p>
        <a id="popup-link" href="#" target="_blank" rel="noopener noreferrer" class="popup-link" hidden>Besøk nettside ↗</a>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  // ── Stjernefelt (fallback-banner uten bilde) ────────────────────
  document.querySelectorAll<HTMLElement>('.banner-stars').forEach(container => {
    for (let i = 0; i < 65; i++) {
      const s = document.createElement('span')
      s.className = 'star'
      const size = Math.random() * 2.5 + 0.8
      s.style.cssText = `left:${Math.random()*100}%;top:${Math.random()*100}%;width:${size}px;height:${size}px;animation-delay:${Math.random()*4}s;animation-duration:${Math.random()*3+2}s;`
      container.appendChild(s)
    }
  })

  // ── Hero: bannerkarusell ────────────────────────────────────────
  const bannerSection = document.querySelector('.hero-banner') as HTMLElement | null
  const bannerSlides  = Array.from(document.querySelectorAll<HTMLElement>('[data-banner-slide]'))
  const bannerDots    = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-banner-dot]'))
  const bannerPrev    = document.getElementById('banner-prev')
  const bannerNext    = document.getElementById('banner-next')

  if (bannerSection && bannerSlides.length > 1) {
    const ROTATE_MS = 7000
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let current = 0
    let timer: number | undefined

    const showBanner = (i: number) => {
      current = (i + bannerSlides.length) % bannerSlides.length
      bannerSlides.forEach((s, idx) => {
        const active = idx === current
        s.classList.toggle('is-active', active)
        if (active) { s.removeAttribute('aria-hidden'); s.removeAttribute('tabindex') }
        else { s.setAttribute('aria-hidden', 'true'); s.setAttribute('tabindex', '-1') }
      })
      bannerDots.forEach((d, idx) => {
        d.classList.toggle('is-active', idx === current)
        d.setAttribute('aria-selected', String(idx === current))
      })
    }
    const stopRotate = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined } }
    const startRotate = () => {
      if (reducedMotion || timer !== undefined) return
      timer = window.setInterval(() => showBanner(current + 1), ROTATE_MS)
    }
    // Manuell navigering nullstiller klokka så neste autobytte ikke kommer brått
    const goTo = (i: number) => { stopRotate(); showBanner(i); startRotate() }

    bannerPrev?.addEventListener('click', () => goTo(current - 1))
    bannerNext?.addEventListener('click', () => goTo(current + 1))
    bannerDots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)))

    bannerSection.addEventListener('mouseenter', stopRotate)
    bannerSection.addEventListener('mouseleave', startRotate)
    document.addEventListener('visibilitychange', () => document.hidden ? stopRotate() : startRotate())
    startRotate()
  }

  // ── Partner-popup ────────────────────────────────────────────────
  const popup       = document.getElementById('partner-popup') as HTMLElement | null
  const backdrop    = popup?.querySelector('.partner-popup-backdrop') as HTMLElement | null
  const closeBtn    = popup?.querySelector('.partner-popup-close') as HTMLElement | null
  const popupLogo   = document.getElementById('popup-logo-wrap') as HTMLElement | null
  const popupName   = document.getElementById('popup-name') as HTMLElement | null
  const popupDesc   = document.getElementById('popup-description') as HTMLElement | null
  const popupLink   = document.getElementById('popup-link') as HTMLAnchorElement | null

  let lastFocused: HTMLElement | null = null

  function openPartnerPopup(data: { name: string; description: string; url: string; logo: string }) {
    if (!popup || !popupLogo || !popupName || !popupDesc || !popupLink) return
    popupLogo.innerHTML = data.logo
      ? `<img src="${data.logo}" alt="" class="popup-logo-img" />`
      : `<span class="sponsor-initial sponsor-initial--lg">${data.name.charAt(0)}</span>`
    popupName.textContent = data.name
    popupDesc.textContent = data.description || ''
    if (data.url) {
      popupLink.href = data.url
      popupLink.removeAttribute('hidden')
    } else {
      popupLink.setAttribute('hidden', '')
    }
    popup.removeAttribute('hidden')
    document.body.style.overflow = 'hidden'
    closeBtn?.focus()
  }

  function closePartnerPopup() {
    popup?.setAttribute('hidden', '')
    document.body.style.overflow = ''
    lastFocused?.focus()
  }

  document.querySelectorAll<HTMLElement>('.sponsor-item').forEach(btn => {
    btn.addEventListener('click', () => {
      lastFocused = btn
      openPartnerPopup({
        name:        btn.dataset.name        ?? '',
        description: btn.dataset.description ?? '',
        url:         btn.dataset.url         ?? '',
        logo:        btn.dataset.logo        ?? '',
      })
    })
  })

  backdrop?.addEventListener('click', closePartnerPopup)
  closeBtn?.addEventListener('click', closePartnerPopup)
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && popup && !popup.hasAttribute('hidden')) closePartnerPopup()
  })
</script>

