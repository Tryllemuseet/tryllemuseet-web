---
// src/pages/bak-teppet/[slug].astro
//
// One kit's content, for visitors whose cookie unlocks it (see
// src/lib/bakTeppet.ts). Rendered on demand; anyone else is sent back to the
// code form. Not linked from navigation; noindex everywhere.
export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro'
import NarrateButton from '../../components/NarrateButton.astro'
import {
  getKitBySlug,
  portableTextToHtml,
  portableTextToPlainText,
  urlFor,
} from '../../lib/sanity'
import {
  BAK_TEPPET_PATH,
  loadSession,
  setPrivateHeaders,
  videoEmbedUrl,
} from '../../lib/bakTeppet'

setPrivateHeaders(Astro.response.headers)

const { slug } = Astro.params
const session = await loadSession(Astro.cookies)
if (!session || !slug || !session.unlocked.some(k => k.slug === slug)) {
  return Astro.redirect(BAK_TEPPET_PATH)
}

const kit = await getKitBySlug(session.client, slug)
if (!kit) return Astro.redirect(BAK_TEPPET_PATH)

const items = kit.items ?? []
---

<BaseLayout title={`${kit.title} — Bak teppet — Tryllemuseet`} noindex>

  <nav class="breadcrumb container">
    <a href={BAK_TEPPET_PATH}>Bak teppet</a>
    <span>›</span>
    <span aria-current="page">{kit.title}</span>
  </nav>

  <section class="kit-hero">
    <div class:list={['container', 'kit-hero-inner', { 'kit-hero-inner--bilde': kit.coverImage?.asset }]}>
      {kit.coverImage?.asset && (
        <div class="kit-hero-img">
          <img
            src={urlFor(kit.coverImage).width(680).format('webp').url()}
            alt={kit.coverImage.alt ?? kit.title}
          />
        </div>
      )}
      <div>
        <p class="section-label">Bak teppet</p>
        <h1>{kit.title}</h1>
        {kit.intro && kit.intro.length > 0 && (
          <>
            <div class="prose kit-intro" set:html={portableTextToHtml(kit.intro)} />
            <NarrateButton text={portableTextToPlainText(kit.intro)} label={`Les om ${kit.title} høyt`} />
          </>
        )}
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container kit-grid">

      <div class="kit-items">
        {items.length > 1 && (
          <nav class="kit-toc" aria-label="Triks i kofferten">
            <p class="kit-label">Triks i kofferten</p>
            <ol>
              {items.map(item => <li><a href={`#triks-${item._key}`}>{item.title}</a></li>)}
            </ol>
          </nav>
        )}

        {items.map((item, i) => (
          <article class="kit-item" id={`triks-${item._key}`}>
            <div class="section-head">
              <h2><span class="kit-nr">{i + 1}.</span> {item.title}</h2>
              <NarrateButton text={portableTextToPlainText(item.description)} label={`Les «${item.title}» høyt`} />
            </div>

            {item.image?.asset && (
              <img
                class="kit-item-img"
                src={urlFor(item.image).width(900).format('webp').url()}
                alt={item.image.alt ?? item.title}
                loading="lazy"
              />
            )}

            {item.description && item.description.length > 0 && (
              <div class="prose" set:html={portableTextToHtml(item.description)} />
            )}

            {(item.videos ?? []).map(v => {
              const embed = videoEmbedUrl(v.url)
              return embed ? (
                <figure class="kit-video">
                  <div class="kit-video-wrap">
                    <iframe
                      src={embed}
                      title={v.label ?? `Video: ${item.title}`}
                      loading="lazy"
                      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                      allowfullscreen
                    ></iframe>
                  </div>
                  {v.label && <figcaption>{v.label}</figcaption>}
                </figure>
              ) : (
                <p><a class="kit-lenke" href={v.url} target="_blank" rel="noopener noreferrer">{v.label ?? 'Se video'} →</a></p>
              )
            })}
          </article>
        ))}

        {items.length === 0 && <p>Innholdet kommer snart.</p>}
      </div>

      {kit.contents && kit.contents.length > 0 && (
        <aside class="kit-innhold">
          <p class="kit-label">I kofferten finner du</p>
          <ul>{kit.contents.map(c => <li>{c}</li>)}</ul>
        </aside>
      )}

    </div>

    <div class="container page-nav">
      <a href={BAK_TEPPET_PATH}>← Bak teppet</a>
    </div>
  </section>

</BaseLayout>

<style>
  .breadcrumb { padding-block: 1.5rem 0; font-family: var(--font-ui); font-size: 0.85rem; color: #777; }
  .breadcrumb a { color: var(--burgundy); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span[aria-current] { color: #999; }

  .kit-hero { padding-block: 2.5rem 2rem; background: var(--cream); }
  .kit-hero-inner { display: grid; gap: 2.5rem; align-items: center; }
  .kit-hero-inner--bilde { grid-template-columns: minmax(0, 340px) 1fr; }
  .kit-hero-img img { width: 100%; border-radius: 6px; box-shadow: 0 4px 20px rgba(0,0,0,0.12); }
  .kit-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--burgundy);
    margin-block: 0.5rem 0.75rem;
  }
  .kit-intro { color: #555; margin-bottom: 0.75rem; }

  .section-pad { padding-block: 3rem; }

  .kit-grid { display: grid; grid-template-columns: 1fr 260px; gap: 3rem; align-items: start; }
  .kit-grid:not(:has(.kit-innhold)) { grid-template-columns: 1fr; max-width: 820px; }

  .kit-label {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-dark, var(--gold));
    margin-bottom: 0.5rem;
  }

  .kit-toc { margin-bottom: 2.5rem; }
  .kit-toc ol { margin: 0; padding-left: 1.3rem; font-family: var(--font-ui); }
  .kit-toc a { color: var(--burgundy); }

  .kit-item { padding-bottom: 2.5rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--cream-dark, #e5dccb); scroll-margin-top: 6rem; }
  .kit-item:last-of-type { border-bottom: 0; }
  .section-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .kit-item h2 { font-family: var(--font-display); font-size: 1.5rem; color: var(--burgundy); }
  .kit-nr { color: var(--gold-dark, var(--gold)); }
  .kit-item-img { width: 100%; border-radius: 6px; margin-bottom: 1.25rem; }

  .kit-video { margin: 1.5rem 0 0; }
  .kit-video-wrap { position: relative; aspect-ratio: 16/9; border-radius: 4px; overflow: hidden; background: #000; }
  .kit-video-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .kit-video figcaption { font-family: var(--font-ui); font-size: 0.8rem; color: #777; margin-top: 0.4rem; }
  .kit-lenke { font-family: var(--font-ui); font-weight: 600; color: var(--burgundy); }

  .kit-innhold { background: rgba(212,168,67,0.08); border: 1px solid rgba(212,168,67,0.35); border-radius: 8px; padding: 1.25rem 1.5rem; position: sticky; top: 6rem; }
  .kit-innhold ul { margin: 0; padding-left: 1.2rem; font-family: var(--font-body); font-size: 0.92rem; color: #444; }

  .page-nav { display: flex; gap: 0.75rem; padding-top: 2rem; border-top: 1px solid var(--cream-dark); font-family: var(--font-ui); font-size: 0.875rem; }
  .page-nav a { color: var(--grey); text-decoration: none; border: 1px solid var(--cream-dark); padding: 0.4rem 1rem; border-radius: var(--radius); }
  .page-nav a:hover { color: var(--burgundy); border-color: var(--gold); }

  @media (max-width: 720px) {
    .kit-hero-inner--bilde, .kit-grid { grid-template-columns: 1fr; }
    .kit-innhold { position: static; order: -1; }
  }
</style>
