---
// src/pages/bak-teppet/[slug].astro
//
// One kit's content, for visitors whose cookie unlocks it (see
// src/lib/bakTeppet.ts). Rendered on demand; anyone else is sent back to the
// code form. Not linked from navigation; noindex everywhere.
export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro'
import NarrateButton from '../../components/NarrateButton.astro'
import KitTrickCards from '../../components/KitTrickCards.astro'
import {
  getKitBySlug,
  portableTextToHtml,
  portableTextToPlainText,
  urlFor,
} from '../../lib/sanity'
import {
  BAK_TEPPET_PATH,
  loadSession,
  loginUrl,
  setPrivateHeaders,
} from '../../lib/bakTeppet'

setPrivateHeaders(Astro.response.headers)

const { slug } = Astro.params
const session = await loadSession(Astro.cookies)
if (!session || !slug) return Astro.redirect(BAK_TEPPET_PATH)
if (!session.unlocked.some(k => k.slug === slug)) return Astro.redirect(loginUrl(Astro.url.pathname))

const kit = await getKitBySlug(session.client, slug)
if (!kit) return Astro.redirect(BAK_TEPPET_PATH)

const tricks = kit.tricks ?? []
---

<BaseLayout title={`${kit.title} — Bak teppet — Tryllemuseet`} noindex>

  <nav class="breadcrumb container">
    <a href={BAK_TEPPET_PATH}>Bak teppet</a>
    <span>›</span>
    <span aria-current="page">{kit.title}</span>
  </nav>

  <section class="kit-hero">
    <div class:list={['container', 'kit-hero-inner', { 'kit-hero-inner--bilde': kit.coverImage?.asset }]}>
      {kit.coverImage?.asset && (
        <div class="kit-hero-img">
          <img
            src={urlFor(kit.coverImage).width(680).format('webp').url()}
            alt={kit.coverImage.alt ?? kit.title}
          />
        </div>
      )}
      <div>
        <p class="section-label">Bak teppet</p>
        <h1>{kit.title}</h1>
        {kit.intro && kit.intro.length > 0 && (
          <>
            <div class="prose kit-intro" set:html={portableTextToHtml(kit.intro)} />
            <NarrateButton text={portableTextToPlainText(kit.intro)} label={`Les om ${kit.title} høyt`} />
          </>
        )}
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container kit-grid">

      <div class="kit-items">
        <h2 class="kit-h2">Triks i settet</h2>
        {tricks.length > 0
          ? <KitTrickCards tricks={tricks} numbered />
          : <p>Innholdet kommer snart.</p>}
      </div>

      {kit.contents && kit.contents.length > 0 && (
        <aside class="kit-innhold">
          <p class="kit-label">I settet finner du</p>
          <ul>{kit.contents.map(c => <li>{c}</li>)}</ul>
        </aside>
      )}

    </div>

    <div class="container page-nav">
      <a href={BAK_TEPPET_PATH}>← Bak teppet</a>
    </div>
  </section>

</BaseLayout>

<style>
  .breadcrumb { padding-block: 1.5rem 0; font-family: var(--font-ui); font-size: 0.85rem; color: #777; }
  .breadcrumb a { color: var(--burgundy); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span[aria-current] { color: #999; }

  .kit-hero { padding-block: 2.5rem 2rem; background: var(--cream); }
  .kit-hero-inner { display: grid; gap: 2.5rem; align-items: center; }
  .kit-hero-inner--bilde { grid-template-columns: minmax(0, 340px) 1fr; }
  .kit-hero-img img { width: 100%; border-radius: 6px; box-shadow: 0 4px 20px rgba(0,0,0,0.12); }
  .kit-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--burgundy);
    margin-block: 0.5rem 0.75rem;
  }
  .kit-intro { color: #555; margin-bottom: 0.75rem; }

  .section-pad { padding-block: 3rem; }

  .kit-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 3rem; align-items: start; }
  .kit-grid:not(:has(.kit-innhold)) { grid-template-columns: minmax(0, 1fr); }

  .kit-h2 { font-family: var(--font-display); font-size: 1.5rem; color: var(--burgundy); margin-bottom: 1.25rem; }

  .kit-label {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-dark, var(--gold));
    margin-bottom: 0.5rem;
  }

  .kit-innhold { background: rgba(212,168,67,0.08); border: 1px solid rgba(212,168,67,0.35); border-radius: 8px; padding: 1.25rem 1.5rem; position: sticky; top: 6rem; }
  .kit-innhold ul { margin: 0; padding-left: 1.2rem; font-family: var(--font-body); font-size: 0.92rem; color: #444; }

  .page-nav { display: flex; gap: 0.75rem; padding-top: 2rem; border-top: 1px solid var(--cream-dark); font-family: var(--font-ui); font-size: 0.875rem; }
  .page-nav a { color: var(--grey); text-decoration: none; border: 1px solid var(--cream-dark); padding: 0.4rem 1rem; border-radius: var(--radius); }
  .page-nav a:hover { color: var(--burgundy); border-color: var(--gold); }

  @media (max-width: 720px) {
    .kit-hero-inner--bilde, .kit-grid { grid-template-columns: 1fr; }
    .kit-innhold { position: static; order: -1; }
  }
</style>
